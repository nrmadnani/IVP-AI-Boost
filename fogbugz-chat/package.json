{
  "name": "fogbugz-chat",
  "displayName": "IVP AI Boost",
  "description": "A chat interface to enterprise knowledge",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "author": {"name": "nrmadnani"},
  "publisher": "nrmadnani",
  "activationEvents": [],
  "icon": "./media/logo big.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fogbugz-chat.startChat",
        "title": "FogBugz: Start Chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fogbugz-chat-sidebar",
          "title": "FogBugz Chat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "fogbugz-chat-sidebar": [
        {
          "type": "webview",
          "id": "fogbugz-chat.chatView",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}