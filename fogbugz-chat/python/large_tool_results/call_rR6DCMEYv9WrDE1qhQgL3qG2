re business_day_report = @start_business_date order by id\n\n--net market value\nselect MVCurrent,Market_Value_Current,MVPercent_Current,NAVPercent_Current,MVPrevious,Market_Value_Previous,MVPercent_Previous,NAVPercent_Previous\nfrom IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_NetMV where business_day_report = @start_business_date order by id\n\n--source type\nSELECT [Source_Type_Current],[Pricing_Source_Selected_Current],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[Priority_Current],[Source_Type_Previous],[Pricing_Source_Selected_Previous],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous] \nfrom IVPPriceMaster.dbo.[PM_PricingSourceAnaltyics_SourceType] where business_day_report = @start_business_date order by id\n\n--grand total\nSELECT [GrandTotalCurrent],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[GrandTotalPrevious],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous]\n  FROM [IVPPriceMaster].[dbo].[PM_PricingSourceAnaltyics_GrandTotal]  where business_day_report = @start_business_date order by id\nEND\t   \nELSE    \nBEGIN   \t    \n\t--select max(business_day) into #tempPreviousBusiness_Days \n\n\tinsert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_BusinessDay(business_day) values(@start_business_date)\n\nDECLARE @prev_business_date DATE-- = '2024-06-28'\nSELECT @prev_business_date = MAX(business_day) from IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_1 WITH (NOLOCK) where business_day < @start_business_date  group by business_day --group by business_day\nDECLARE @pm_security_id VARCHAR(20) = 'pm_security_id'\nDECLARE @pm_pricing_id VARCHAR(20) = 'pm_pricing_id'\nDECLARE @MarketValueColumnConfigValue VARCHAR(50) = 'stdMarketValue'\nDECLARE @PricingSourceSelected VARCHAR(50) = 'stdPricingSourceSelected'\nDECLARE @CommonAttributes VARCHAR(MAX)\n\nDECLARE @ScreenIdentifiers TABLE\n(\n\tid\t\t\t\t\tINT IDENTITY(1,1),\n\tscreen_identifier\tVARCHAR(50),\n\tattribute_real_name VARCHAR(1000) NULL\n)\nINSERT INTO @ScreenIdentifiers(screen_identifier)\nVALUES (@MarketValueColumnConfigValue),(@PricingSourceSelected)\n\nUPDATE @ScreenIdentifiers\nSET attribute_real_name = PMA.attribute_real_name\nFROM\tIVPPriceMaster.dbo.ivp_pm_column_configuration CC\nINNER JOIN @ScreenIdentifiers SI ON SI.screen_identifier = CC.screen_identifier \nINNER JOIN IVPPriceMaster.dbo.ivp_pm_attribute PMA ON CC.column_ids = PMA.attribute_id AND PMA.is_active = 1 \n--INNER JOIN ivppricemaster.dbo.ivp_pm_pricing_list PL ON CC.pricing_list_id = PL.pricing_list_id\n--INNER JOIN RAD_GetSplittedList(@comma_separated_pricing_lists, ',') pricing_list\tON  PL.pricing_list_name = pricing_list.item \n\nSelect @CommonAttributes  = ''\nSELECT\t@CommonAttributes = @CommonAttributes + ',' + attribute_real_name FROM @ScreenIdentifiers  order by id\n\nDECLARE @MarketValueQuery VARCHAR(MAX) = 'DECLARE @DateRange TABLE'+ \n\t\t\t\t\t\t\t\t\t\t ' ('+ \n\t\t\t\t\t\t\t\t\t\t\t' business_dates DATETIME' +\n\t\t\t\t\t\t\t\t\t\t ' )' +\n\t\t\t\t\t\t\t\t\t\t ' INSERT INTO @DateRange'+\n\t\t\t\t\t\t\t\t\t\t '\tVALUES(''' + CONVERT(VARCHAR(100),@start_business_date) +'''),(''' + CONVERT(VARCHAR(100),@prev_business_date) + ''')' +\n\n\t\t\t\t\t\t\t\t\t\t '\tDECLARE @TotalMarketValue TABLE'+\n\t\t\t\t\t\t\t\t\t\t '\t('+\n\t\t\t\t\t\t\t\t\t\t\t\t' business_day DATE,' +\n\t\t\t\t\t\t\t\t\t\t\t\t' pm_pricing_id VARCHAR(1000),'+\n\t\t\t\t\t\t\t\t\t\t\t\t' pm_security_id VARCHAR(1000),'+\n\t\t\t\t\t\t\t\t\t\t\t\t' Market_Value DECIMAL(18,6) NULL,'+\n\t\t\t\t\t\t\t\t\t\t\t\t' Pricing_Source_Selected VARCHAR(1000)'+\n\t\t\t\t\t\t\t\t\t\t '\t)' +\n\t\t\t\t\t\t\t\t\t\t '\tINSERT INTO @TotalMarketValue'\n\nSELECT  @MarketValueQuery += ' SELECT p'+ CONVERT(VARCHAR(100),CC.pricing_list_id) + '.business_day, p'+ CONVERT(VARCHAR(100),CC.pricing_list_id) + '.' + @pm_pricing_id + ',' +\n\t\t\t\t\t\t\t   @pm_security_id + @CommonAttributes + \n\t\t\t\t\t\t\t ' FROM IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_' + CONVERT(VARCHAR(100),CC.pricing_list_id) + ' p' + CONVERT(VARCHAR(100),CC.pricing_list_id) + ' WITH (NOLOCK) '+\n\t\t\t\t\t\t\t ' INNER JOIN (\n\t\t\t\t\t\t\t\t\t\t\tSELECT\tbusiness_day, '+ @pm_pricing_id +',MAX(archive_id) As MAX_archive_id\n\t\t\t\t\t\t\t\t\t\t\tFROM\tIVPPriceMaster_Archive.dbo.ivp_pmd_price_list_' + CONVERT(VARCHAR(100),CC.pricing_list_id) + ' WITH (NOLOCK) '+\n\t\t\t\t\t\t\t '\t\t\t\t INNER JOIN  @DateRange DR ON DR.business_dates = business_day' +\n\t\t\t\t\t\t\t '\t\t\t\tGROUP BY business_day, ' + @pm_pricing_id +\n\t\t\t\t\t\t\t '\t\t\t  ) arch ON arch.' + @pm_pricing_id + ' = p' + CONVERT(VARCHAR(100),CC.pricing_list_id) + '.' + @pm_pricing_id + \n\t\t\t\t\t\t\t '\t\t\t\t\t AND arch.MAX_archive_id' + ' = p' + CONVERT(VARCHAR(100),CC.pricing_list_id) + '.archive_id' +  \n\t\t\t\t\t\t\t ' UNION'\nFROM\tIVPPriceMaster.dbo.ivp_pm_column_configuration CC\nINNER JOIN @ScreenIdentifiers SI ON SI.screen_identifier = CC.screen_identifier \nINNER JOIN IVPPriceMaster.dbo.ivp_pm_attribute PMA ON CC.column_ids = PMA.attribute_id AND PMA.is_active = 1\n--INNER JOIN ivppricemaster.dbo.ivp_pm_pricing_list PL ON CC.pricing_list_id = PL.pricing_list_id\n--INNER JOIN RAD_GetSplittedList(@comma_separated_pricing_lists, ',') pricing_list\tON  PL.pricing_list_name = pricing_list.item \n\nSET\t@MarketValueQuery = LEFT(@MarketValueQuery,LEN(@MarketValueQuery)-5) \n\n\n-------------------------------SELECT Total Positions DataSet---------------------------------------------------------\nSET\t@MarketValueQuery += ' DECLARE @FundMarketValueCurrent DECIMAL(30,18)' +\n\t\t\t\t\t\t ' DECLARE @TotalNAVCurrent DECIMAL(30,18)' +\n\t\t\t\t\t\t ' DECLARE @FundMarketValuePrevious DECIMAL(30,18)' +\n\t\t\t\t\t\t ' DECLARE @TotalNAVPrevious DECIMAL(30,18)' +\n\t\t\t\t\t\t \n\t\t\t\t\t\t ' SELECT @FundMarketValueCurrent = SUM(Market_Value)' +\n\t\t\t\t\t\t ' FROM @TotalMarketValue' +\n\t\t\t\t\t\t ' WHERE business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t \n\t\t\t\t\t\t ' SELECT @TotalNAVCurrent = SUM(Market_Value)' +\n\t\t\t\t\t\t ' FROM @TotalMarketValue' +\n\t\t\t\t\t\t ' WHERE business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t \n\t\t\t\t\t\t ' SELECT @FundMarketValuePrevious = SUM(Market_Value)' +\n\t\t\t\t\t\t ' FROM @TotalMarketValue' +\n\t\t\t\t\t\t ' WHERE business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t \n\t\t\t\t\t\t ' SELECT @TotalNAVPrevious = SUM(Market_Value)' +\n\t\t\t\t\t\t ' FROM @TotalMarketValue' +\n\t\t\t\t\t\t ' WHERE business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\n\t\t\t\t\t\t-----insert into total assets or in report table1\n\t\t\t\t\t\t \n\t\t\t\t\t\t '  insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_TotalAssets(business_day_Current,NumberOfCurrentPositions,Market_Value_Current,NAV_Current,business_day_Previous,NumberOfPreviousPositions,Market_Value_Previous,NAV_Previous,business_day_report) '+\n\n\t\t\t\t\t\t ' SELECT curr.business_day AS business_day_Current,curr.NumberOfCurrentPositions,curr.Market_Value_Current,curr.NAV_Current,'+\n\t\t\t\t\t\t ' prev.business_day AS business_day_Previous,prev.NumberOfPreviousPositions,IsNull(prev.Market_Value_Previous,0) as Market_Value_Previous,prev.NAV_Previous,' +cast(@start_business_date as varchar)+\n\t\t\t\t\t\t ' as business_day_report\n\t\t\t\t\t\t FROM' +\n\t\t\t\t\t\t ' ('+\n\t\t\t\t\t\t\t\t ' SELECT\t''Total'' AS Totals,T1.business_day,COUNT(T1.'+ CONVERT(VARCHAR(100),@pm_pricing_id) +') AS NumberOfCurrentPositions,IsNull(@FundMarketValueCurrent,0) AS Market_Value_Current,@TotalNAVCurrent As NAV_Current' +\n\t\t\t\t\t\t\t\t ' FROM\t\t@TotalMarketValue T1' +\n\t\t\t\t\t\t\t\t ' WHERE\tT1.business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t\t\t ' GROUP BY T1.business_day' + \n\t\t\t\t\t\t ' ) curr' +\n\t\t\t\t\t\t ' INNER JOIN' +\n\t\t\t\t\t\t ' (' +\n\t\t\t\t\t\t\t ' SELECT\t''Total'' AS Totals,T1.business_day,COUNT(T1.'+ CONVERT(VARCHAR(100),@pm_pricing_id) +') AS NumberOfPreviousPositions,IsNull(@FundMarketValuePrevious,0) AS Market_Value_Previous,@TotalNAVPrevious As NAV_Previous' +\n\t\t\t\t\t\t\t ' FROM\t\t@TotalMarketValue T1' +\n\t\t\t\t\t\t\t ' WHERE\tT1.business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t\t ' GROUP BY T1.business_day' +\n\t\t\t\t\t\t ' )prev ON curr.Totals = prev.Totals'\n----------------------------------------------------------------------------------------------------------------------\n\nDECLARE @SelectQuery VARCHAR(MAX)\n\nSET @SelectQuery =\n\t\t\t\t\t\t \n------------------------------LMV and SMV wise SUM of Market Values--------------------------------------------------- \n\n                         --insert into Net Market Value OR In Report Table 2\n\t\t\t\t\t\t ' insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_NetMV(MVCurrent,Market_Value_Current,MVPercent_Current,NAVPercent_Current,MVPrevious,Market_Value_Previous,MVPercent_Previous,NAVPercent_Previous,business_day_report) '+\n\n\t\t\t\t\t\t ' SELECT curr.MVCurrent,IsNull(curr.CurrentMarketValue,0) AS Market_Value_Current,curr.MVPercent AS MVPercent_Current,curr.NAVPercent AS NAVPercent_Current,'+\n\t\t\t\t\t\t ' prev.MVPrevious,IsNull(prev.PreviousMarketValue,0) AS Market_Value_Previous,prev.MVPercent AS MVPercent_Previous,prev.NAVPercent AS NAVPercent_Previous,' +cast(@start_business_date as varchar)+\n\t\t\t\t\t\t ' as business_day_report\n\t\t\t\t\t\t FROM ( ' +\n\t\t\t\t\t\t\t\t\t ' SELECT ''LMV'' AS MVCurrent, SUM(Market_Value) as CurrentMarketValue,SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',1 As Priority' +\n\t\t\t\t\t\t\t\t\t ' FROM @TotalMarketValue ' +\n\t\t\t\t\t\t\t\t\t ' WHERE Market_Value >= 0 ' +\n\t\t\t\t\t\t\t\t\t ' AND business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t ' UNION' +\n\t\t\t\t\t\t\t\t\t ' SELECT ''SMV'' AS SMV, SUM(Market_Value) as ShortMarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',2 As Priority' +\n\t\t\t\t\t\t\t\t\t ' FROM @TotalMarketValue ' +\n\t\t\t\t\t\t\t\t\t ' WHERE Market_Value < 0 ' +\n\t\t\t\t\t\t\t\t\t ' AND business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t\t  ' )curr '+\n\t\t\t\t\t\t ' INNER JOIN ( ' +\n\t\t\t\t\t\t\t\t\t \t\n\t\t\t\t\t\t\t\t\t\t ' SELECT ''LMV'' AS MVPrevious, SUM(Market_Value) as PreviousMarketValue,SUM(Market_Value)/@FundMarketValuePrevious As ''MVPercent'',SUM(Market_Value)/@TotalNAVPrevious ''NAVPercent'',1 As Priority' +\n\t\t\t\t\t\t\t\t\t\t ' FROM @TotalMarketValue ' +\n\t\t\t\t\t\t\t\t\t\t ' WHERE Market_Value >= 0 ' +\n\t\t\t\t\t\t\t\t\t\t ' AND business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t\t ' UNION' +\n\t\t\t\t\t\t\t\t\t\t ' SELECT ''SMV'' AS SMV, SUM(Market_Value) as ShortMarketValue, SUM(Market_Value)/@FundMarketValuePrevious As ''MVPercent'',SUM(Market_Value)/@TotalNAVPrevious ''NAVPercent'',2 As Priority' +\n\t\t\t\t\t\t\t\t\t\t ' FROM @TotalMarketValue ' +\n\t\t\t\t\t\t\t\t\t\t ' WHERE Market_Value < 0 ' +\n\t\t\t\t\t\t\t\t\t\t ' AND business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t            ' ) prev ON curr.MVCurrent = prev.MVPrevious' +\t\n\t\t\t\t\t\t ' ORDER BY curr.[Priority]' +\t\t\t\n\t\t\t\t\t\t \n------------------------------Vendor data classification for Market Values---------------------------------------------\t\n                          -- insert into source type or in report table3\n                         'insert into IVPPriceMaster.dbo.PM_PricingSourceAnalytics_SourceType([Source_Type_Current],[Pricing_Source_Selected_Current],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[Priority_Current],[Source_Type_Previous],[Pricing_Source_Selected_Previous],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous],business_day_report)'+\n\n\t\t\t\t\t\t ' SELECT curr.Source_Type AS Source_Type_Current,curr.Pricing_Source_Selected As Pricing_Source_Selected_Current,curr.TotalCount AS TotalCount_Current,IsNull(curr.MarketValue,0) AS MarketValue_Current,' + \n\t\t\t\t\t\t ' curr.MVPercent AS MVPercent_Current,curr.NAVPercent AS NAVPercent_Current,curr.[Priority] AS Priority_Current, '+\n\t\t\t\t\t\t ' prev.Source_Type AS Source_Type_Previous,prev.Pricing_Source_Selected As Pricing_Source_Selected_Previous,prev.TotalCount AS TotalCount_Previous,IsNull(prev.MarketValue,0) AS MarketValue_Previous,' + \n\t\t\t\t\t\t ' prev.MVPercent AS MVPercent_Previous,prev.NAVPercent AS NAVPercent_Previous,prev.[Priority] AS Priority_Previous, ' +cast(@start_business_date as varchar)+\n\t\t\t\t\t\t ' as business_day_report\n\t\t\t\t\t\t FROM (' +         \t\t\t\t \n\t\t\t\t\t\t\t\t\t ' SELECT ''Vendor'' As Source_Type,Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',1 As [Priority] \n\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t ' AND ISNULL(NULLIF(Pricing_Source_Selected,''''),''Broker'') <> ''Broker'''+\n\t\t\t\t\t\t\t\t\t ' GROUP BY Pricing_Source_Selected ' +\n\t\t\t\t\t\t\t\t\t ' UNION' +\n\t\t\t\t\t\t\t\t\t ' SELECT ''Broker'' AS Source_Type,''Broker'' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',2 As [Priority] \n\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t ' AND NULLIF(Pricing_Source_Selected,'''') = ''Broker''' +\n\t\t\t\t\t\t\t\t\t ' UNION' +\n\t\t\t\t\t\t\t\t\t ' SELECT ''Others'' AS Source_Type,''Others'' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',3 As [Priority] \n\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t ' AND NULLIF(Pricing_Source_Selected,'''') IS NULL ' +\n\t\t\t\t\t\t\t  ' )curr '+\n\t\t\t\t\t\t ' INNER JOIN (' +   \t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t ' SELECT ''Vendor'' As Source_Type,Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',1 As [Priority]\n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t\t ' AND ISNULL(NULLIF(Pricing_Source_Selected,''''),''Broker'') <> ''Broker''\n\t\t\t\t\t\t\t\t\t\t   GROUP BY Pricing_Source_Selected ' +\n\t\t\t\t\t\t\t\t\t\t ' UNION' +\n\t\t\t\t\t\t\t\t\t\t ' SELECT ''Broker'' AS Source_Type,''Broker'' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',2 As [Priority]  \n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t\t ' AND NULLIF(Pricing_Source_Selected,'''') = ''Broker''' +\n\t\t\t\t\t\t\t\t\t\t ' UNION' +\n\t\t\t\t\t\t\t\t\t\t ' SELECT ''Others'' AS Source_Type,''Others'' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent'',3 As [Priority]  \n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t\t\t\t\t ' AND NULLIF(Pricing_Source_Selected,'''') IS NULL ' +\n\t\t\t\t\t\t\t\t\t\t' )prev ON curr.Pricing_Source_Selected = prev.Pricing_Source_Selected' +\n\t\t\t\t\t\t' ORDER BY curr.[Priority]'+\t\t\t\n----------------------------------------------------------------------------------------------------------------------\n\n--------------------------------------Grand Total---------------------------------------------------------------------\n                         -- insert into grand total or in report table 4\n\t\t\t\t\t\t 'insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_GrandTotal([GrandTotalCurrent],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[GrandTotalPrevious],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous],business_day_report)'+\n\n\t\t\t\t\t\t ' SELECT curr.GrandTotalCurrent,curr.TotalCount_Current,curr.Market_Value_Current,curr.MVPercent_Current,curr.NAVPercent_Current,' +\n\t\t\t\t\t\t ' prev.GrandTotalPrevious,prev.TotalCount_Previous,prev.Market_Value_Previous,prev.MVPercent_Previous,prev.NAVPercent_Previous,' +cast(@start_business_date as varchar)+\n\t\t\t\t\t\t ' as business_day_report\n\t\t\t\t\t\t FROM (' +\n\t\t\t\t\t\t\t\t ' SELECT ''GrandTotal'' AS GrandTotalCurrent,COUNT(*) AS TotalCount_Current,SUM(Market_Value) as Market_Value_Current, SUM(Market_Value)/@FundMarketValueCurrent As ''MVPercent_Current'',SUM(Market_Value)/@TotalNAVCurrent ''NAVPercent_Current'' \n\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@start_business_date) + ''''+\n\t\t\t\t\t\t\t  ' )curr' +  \n\t\t\t\t\t\t ' INNER JOIN (' +\n\t\t\t\t\t\t\t\t\t\t ' SELECT ''GrandTotal'' AS GrandTotalPrevious,COUNT(*) AS TotalCount_Previous,SUM(Market_Value) as Market_Value_Previous, SUM(Market_Value)/@FundMarketValuePrevious As ''MVPercent_Previous'',SUM(Market_Value)/@TotalNAVPrevious ''NAVPercent_Previous'' \n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = ''' + CONVERT(VARCHAR(100),@prev_business_date) + '''' +\n\t\t\t\t\t\t\t\t    ' )prev ON curr.GrandTotalCurrent = prev.GrandTotalPrevious'\n----------------------------------------------------------------------------------------------------------------------\n\nPRINT  @MarketValueQuery \nPRINT @SelectQuery\nEXEC(@MarketValueQuery + @SelectQuery)\n\ninsert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_BusinessDay(business_day) values(@start_business_date)\n\nselect business_day_Current,NumberOfCurrentPositions,Market_Value_Current,NAV_Current,business_day_Previous,NumberOfPreviousPositions,Market_Value_Previous,NAV_Previous\nfrom IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_TotalAssets where business_day_report = @start_business_date order by id\n\n--net market value\nselect MVCurrent,Market_Value_Current,MVPercent_Current,NAVPercent_Current,MVPrevious,Market_Value_Previous,MVPercent_Previous,NAVPercent_Previous\nfrom IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_NetMV where business_day_report = @start_business_date order by id\n\n--source type\nSELECT [Source_Type_Current],[Pricing_Source_Selected_Current],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[Priority_Current],[Source_Type_Previous],[Pricing_Source_Selected_Previous],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous] \nfrom IVPPriceMaster.dbo.[PM_PricingSourceAnaltyics_SourceType] where business_day_report = @start_business_date order by id\n\n--grand total\nSELECT [GrandTotalCurrent],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[GrandTotalPrevious],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous]\n  FROM [IVPPriceMaster].[dbo].[PM_PricingSourceAnaltyics_GrandTotal]  where business_day_report = @start_business_date order by id\n\t\nEND\nEND\nGO","html":"USE [IVPPriceMaster]<br />\nGO<br />\n<br />\n/****** Object:&nbsp; StoredProcedure [dbo].[PM_GetPricingSourceAnalysisReport]&nbsp; &nbsp; Script Date: 10/28/2024 9:30:48 AM ******/<br />\nSET ANSI_NULLS ON<br />\nGO<br />\n<br />\nSET QUOTED_IDENTIFIER ON<br />\nGO<br />\n<br />\n<br />\n<br />\n<br />\n<br />\n<br />\n-- =============================================<br />\n-- Author:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Flemin Adambukulam<br />\n-- Create date: 2016-03-03<br />\n-- Description:&nbsp;&nbsp;&nbsp;&nbsp;To retrieve datasets for the Pricing Source Analysis Report<br />\n-- TEST: EXEC [dbo].PM_GetPricingSourceAnalysisReport &#39;2016-01-29&#39;,&#39;Listed,Illiquid&#39;<br />\n-- =============================================<br />\nCREATE OR ALTER&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  PROCEDURE [dbo].[PM_GetPricingSourceAnalysisReport]<br />\n@start_business_date DATE,<br />\n@comma_separated_pricing_lists VARCHAR(1000)<br />\nAS<br />\nBEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;-- SET NOCOUNT ON added to prevent extra result sets from<br />\n&nbsp;&nbsp;&nbsp;&nbsp;-- interfering with SELECT statements.<br />\n&nbsp;&nbsp;&nbsp;&nbsp;SET NOCOUNT ON;<br />\n<br />\nif exists (select 1 from IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_BusinessDay where business_day = @start_business_date)<br />\nBEGIN<br />\n--total assets<br />\nselect business_day_Current,NumberOfCurrentPositions,Market_Value_Current,NAV_Current,business_day_Previous,NumberOfPreviousPositions,Market_Value_Previous,NAV_Previous<br />\nfrom IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_TotalAssets where business_day_report = @start_business_date order by id<br />\n<br />\n--net market value<br />\nselect MVCurrent,Market_Value_Current,MVPercent_Current,NAVPercent_Current,MVPrevious,Market_Value_Previous,MVPercent_Previous,NAVPercent_Previous<br />\nfrom IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_NetMV where business_day_report = @start_business_date order by id<br />\n<br />\n--source type<br />\nSELECT [Source_Type_Current],[Pricing_Source_Selected_Current],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[Priority_Current],[Source_Type_Previous],[Pricing_Source_Selected_Previous],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous] <br />\nfrom IVPPriceMaster.dbo.[PM_PricingSourceAnaltyics_SourceType] where business_day_report = @start_business_date order by id<br />\n<br />\n--grand total<br />\nSELECT [GrandTotalCurrent],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[GrandTotalPrevious],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous]<br />\n&nbsp; FROM [IVPPriceMaster].[dbo].[PM_PricingSourceAnaltyics_GrandTotal]&nbsp; where business_day_report = @start_business_date order by id<br />\nEND&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  <br />\nELSE&nbsp; &nbsp; <br />\nBEGIN&nbsp;  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;--select max(business_day) into #tempPreviousBusiness_Days <br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_BusinessDay(business_day) values(@start_business_date)<br />\n<br />\nDECLARE @prev_business_date DATE-- = &#39;2024-06-28&#39;<br />\nSELECT @prev_business_date = MAX(business_day) from IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_1 WITH (NOLOCK) where business_day &lt; @start_business_date&nbsp; group by business_day --group by business_day<br />\nDECLARE @pm_security_id VARCHAR(20) = &#39;pm_security_id&#39;<br />\nDECLARE @pm_pricing_id VARCHAR(20) = &#39;pm_pricing_id&#39;<br />\nDECLARE @MarketValueColumnConfigValue VARCHAR(50) = &#39;stdMarketValue&#39;<br />\nDECLARE @PricingSourceSelected VARCHAR(50) = &#39;stdPricingSourceSelected&#39;<br />\nDECLARE @CommonAttributes VARCHAR(MAX)<br />\n<br />\nDECLARE @ScreenIdentifiers TABLE<br />\n(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;id&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;INT IDENTITY(1,1),<br />\n&nbsp;&nbsp;&nbsp;&nbsp;screen_identifier&nbsp;&nbsp;&nbsp;&nbsp;VARCHAR(50),<br />\n&nbsp;&nbsp;&nbsp;&nbsp;attribute_real_name VARCHAR(1000) NULL<br />\n)<br />\nINSERT INTO @ScreenIdentifiers(screen_identifier)<br />\nVALUES (@MarketValueColumnConfigValue),(@PricingSourceSelected)<br />\n<br />\nUPDATE @ScreenIdentifiers<br />\nSET attribute_real_name = PMA.attribute_real_name<br />\nFROM&nbsp;&nbsp;&nbsp;&nbsp;IVPPriceMaster.dbo.ivp_pm_column_configuration CC<br />\nINNER JOIN @ScreenIdentifiers SI ON SI.screen_identifier = CC.screen_identifier <br />\nINNER JOIN IVPPriceMaster.dbo.ivp_pm_attribute PMA ON CC.column_ids = PMA.attribute_id AND PMA.is_active = 1 <br />\n--INNER JOIN ivppricemaster.dbo.ivp_pm_pricing_list PL ON CC.pricing_list_id = PL.pricing_list_id<br />\n--INNER JOIN RAD_GetSplittedList(@comma_separated_pricing_lists, &#39;,&#39;) pricing_list&nbsp;&nbsp;&nbsp;&nbsp;ON&nbsp; PL.pricing_list_name = pricing_list.item <br />\n<br />\nSelect @CommonAttributes&nbsp; = &#39;&#39;<br />\nSELECT&nbsp;&nbsp;&nbsp;&nbsp;@CommonAttributes = @CommonAttributes + &#39;,&#39; + attribute_real_name FROM @ScreenIdentifiers&nbsp; order by id<br />\n<br />\nDECLARE @MarketValueQuery VARCHAR(MAX) = &#39;DECLARE @DateRange TABLE&#39;+ <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; (&#39;+ <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#39; business_dates DATETIME&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; )&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; INSERT INTO @DateRange&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;VALUES(&#39;&#39;&#39; + CONVERT(VARCHAR(100),@start_business_date) +&#39;&#39;&#39;),(&#39;&#39;&#39; + CONVERT(VARCHAR(100),@prev_business_date) + &#39;&#39;&#39;)&#39; +<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @TotalMarketValue TABLE&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;(&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#39; business_day DATE,&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#39; pm_pricing_id VARCHAR(1000),&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#39; pm_security_id VARCHAR(1000),&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#39; Market_Value DECIMAL(18,6) NULL,&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#39; Pricing_Source_Selected VARCHAR(1000)&#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;)&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;INSERT INTO @TotalMarketValue&#39;<br />\n<br />\nSELECT&nbsp; @MarketValueQuery += &#39; SELECT p&#39;+ CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39;.business_day, p&#39;+ CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39;.&#39; + @pm_pricing_id + &#39;,&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  @pm_security_id + @CommonAttributes + <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; FROM IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_&#39; + CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39; p&#39; + CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39; WITH (NOLOCK) &#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; INNER JOIN (<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;&nbsp;&nbsp;&nbsp;business_day, &#39;+ @pm_pricing_id +&#39;,MAX(archive_id) As MAX_archive_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;&nbsp;&nbsp;&nbsp;IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_&#39; + CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39; WITH (NOLOCK) &#39;+<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; INNER JOIN&nbsp; @DateRange DR ON DR.business_dates = business_day&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;GROUP BY business_day, &#39; + @pm_pricing_id +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ) arch ON arch.&#39; + @pm_pricing_id + &#39; = p&#39; + CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39;.&#39; + @pm_pricing_id + <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; AND arch.MAX_archive_id&#39; + &#39; = p&#39; + CONVERT(VARCHAR(100),CC.pricing_list_id) + &#39;.archive_id&#39; +&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; UNION&#39;<br />\nFROM&nbsp;&nbsp;&nbsp;&nbsp;IVPPriceMaster.dbo.ivp_pm_column_configuration CC<br />\nINNER JOIN @ScreenIdentifiers SI ON SI.screen_identifier = CC.screen_identifier <br />\nINNER JOIN IVPPriceMaster.dbo.ivp_pm_attribute PMA ON CC.column_ids = PMA.attribute_id AND PMA.is_active = 1<br />\n--INNER JOIN ivppricemaster.dbo.ivp_pm_pricing_list PL ON CC.pricing_list_id = PL.pricing_list_id<br />\n--INNER JOIN RAD_GetSplittedList(@comma_separated_pricing_lists, &#39;,&#39;) pricing_list&nbsp;&nbsp;&nbsp;&nbsp;ON&nbsp; PL.pricing_list_name = pricing_list.item <br />\n<br />\nSET&nbsp;&nbsp;&nbsp;&nbsp;@MarketValueQuery = LEFT(@MarketValueQuery,LEN(@MarketValueQuery)-5) <br />\n<br />\n<br />\n-------------------------------SELECT Total Positions DataSet---------------------------------------------------------<br />\nSET&nbsp;&nbsp;&nbsp;&nbsp;@MarketValueQuery += &#39; DECLARE @FundMarketValueCurrent DECIMAL(30,18)&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; DECLARE @TotalNAVCurrent DECIMAL(30,18)&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; DECLARE @FundMarketValuePrevious DECIMAL(30,18)&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; DECLARE @TotalNAVPrevious DECIMAL(30,18)&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; SELECT @FundMarketValueCurrent = SUM(Market_Value)&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; FROM @TotalMarketValue&#39; +<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &#39; WHERE business_day = &#39;&#39;&#39; + CONVERT(VARCHAR(100),@start_business_date) + &#39;&#39;&#39;&#39; +<br />\n&nbsp;&nbsp