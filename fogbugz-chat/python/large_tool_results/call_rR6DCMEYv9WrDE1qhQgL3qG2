d_Tag,cast(last_modified_on as date)\n\t--from IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_3\n\t--where cast(last_modified_on as date) = @date and cast(last_modified_on as time) >= @start_time and cast(last_modified_on as time)<=@end_time and is_active=1 and is_latest=1 and action_column <> 'D'\n\tSET @query = '\n    SELECT pm_pricing_id, pm_security_id, Current_Mark, Bid_Mid_Tag, CAST(last_modified_on AS DATE),Previous_day_price\n    FROM IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_' + CAST(@data_source_id AS NVARCHAR) + '\n    WHERE CAST(last_modified_on AS DATE) = ''' + CAST(@date AS NVARCHAR) + '''\n        AND CAST(last_modified_on AS TIME) >= ''' + CAST(@start_time AS NVARCHAR) + '''\n        AND CAST(last_modified_on AS TIME) <= ''' + CAST(@end_time AS NVARCHAR) + '''\n        AND is_active = 1\n        AND is_latest = 1\n        AND action_column <> ''D''';\n\n\t\t\t  print(@query)\n\t\t\t  INSERT INTO #price_list_data\n\t\t\t  EXEC(@query)\n\tend\n\n\n\tINSERT INTO #finalData\n\tSELECT cusip,Bond_Name,Current_Mark,Type,Update_Time,Last_Mark\n\tfrom #staticSecurityData sd join #price_list_data pd\n\ton sd.pm_security_id = pd.pm_security_id \n\n\tselect * from #finalData\n\n\tDrop table #finalData\n\nEND","html":"use IVPPriceMaster<br />\ngo<br />\n<br />\nCREATE OR ALTER PROC [dbo].[ivp_pm_get_custom_price_change_report](<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@date DATE,<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@start_time TIME,<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@end_time TIME<br />\n)<br />\nAS<br />\nBEGIN<br />\n<br />\n&nbsp; &nbsp; DECLARE @query VARCHAR(MAX) = &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @max_count INT = 0<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @count INT = 0<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @data_source_id INT<br />\n<br />\n&nbsp; &nbsp; DECLARE @pricinglist_list Table(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;id INT IDENTITY(1,1), pricing_list_id INT<br />\n&nbsp;&nbsp;&nbsp;&nbsp;)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CR