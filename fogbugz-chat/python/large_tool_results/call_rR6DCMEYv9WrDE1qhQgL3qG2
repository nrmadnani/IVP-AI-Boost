ce FROM IVPPriceMasterVendor.dbo.ivp_pmd_feed_standard_dictionary ds ' \n\t\t\t\t+ 'inner join IVPPriceMaster.dbo.ivp_pm_static_security_data sd '\n\t\t\t\t+ 'on ds.' + @primaryFieldName + ' = sd.' + @primaryFieldAttribute\n\t\t\t\t+ ' where ds.DataSource = ''' + @dataSourceName\n\t\t\t\t+ ''' AND ds.business_day= ''' + CAST(@current_business_day AS VARCHAR) + '''  and sd.pm_security_id = ''' + @pm_security_id + ''' and sd.is_latest=1 '  \n\t\t\t\t-- + ''' AND ds.business_day= '''\n\t\t\t\t--(select max(sd.business_day) '\n\t\t\t\t--\t\t\t\t\t\t+ 'from IVPPriceMaster.dbo.ivp_pm_static_security_data sd '\n\t\t\t\t--\t\t\t\t\t\t+ 'where sd.business_day= ''' + CAST(@current_business_day AS VARCHAR) + ''' and sd.pm_security_id = ''' + @pm_security_id+ ''' ) '\n\t\t\t\t--+ ' and sd.pm_security_id = ''' + @pm_security_id + ''' and sd.is_latest=1 '  \n  \n   print @query\n   print ''\n\tINSERT INTO @ResultTable_Bid(bid,datasource) \n\tEXEC (@query)\n  \nEND  \n  \nSELECT * from @ResultTable_Mid\nSELECT * FROM @ResultTable_Bid\nEND  \nGO","html":"USE [IVPPriceMaster_Archive]<br />\nGO<br />\n<br />\n/****** Object:&nbsp; StoredProcedure [dbo].[sp_ivp_pm_get_dealers_mid]&nbsp; &nbsp; Script Date: 5/6/2024 5:19:22 PM ******/<br />\nSET ANSI_NULLS ON<br />\nGO<br />\n<br />\nSET QUOTED_IDENTIFIER ON<br />\nGO<br />\n<br />\n<br />\n<br />\n&nbsp;CREATE OR ALTER&nbsp; &nbsp; &nbsp; proc [dbo].[sp_ivp_pm_get_dealers_mid]&nbsp; <br />\n@pm_security_id varchar(200),&nbsp; <br />\n@current_business_day date,&nbsp; <br />\n@data_sources varchar(max)&nbsp; <br />\nas&nbsp; <br />\nbegin&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;select item into #datasources from RAD_GetSplittedList(@data_sources,&#39;,&#39;)&nbsp; <br />\n&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @tempDataSourceMidField TABLE(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; id INT IDENTITY (1,1),<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; data_source_name VARCHAR(200),<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; fie