ce_name VARCHAR(200),\n\t    field_mapped_to_bid VARCHAR(200),\n\t\tprimary_fields VARCHAR(200)\n\t)\n\n\tdeclare @ResultTable_Mid Table(  \n\t\tdatasource NVARCHAR(MAx),  \n\t\tmid NVARCHAR(MAX)\n\t)\n\n\tdeclare @ResultTable_Bid Table(  \n\t\tdatasource NVARCHAR(MAx),  \n\t\tbid NVARCHAR(MAX)\n\t)  \n  \n\tDeclare @count int = 0\n\tDeclare @maxCount int\n\tDeclare @query nvarchar(max)\n\tDECLARE @midField VARCHAR(200)\n\tDECLARE @bidField VARCHAR(200)\n\tDECLARE @dataSourceName VARCHAR(200)\n\tDECLARE @primaryFieldName VARCHAR(200)\n\tDECLARE @primaryFieldAttribute VARCHAR(200)\n\n\tinsert into @tempDataSourceMidField (data_source_name, field_mapped_to_mid, primary_fields)\n\tselect data_source_name, femd.feed_field_id, fs.primary_fields \n\tfrom IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm\n\tjoin IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd\n\ton femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id\n\tjoin IVPPriceMaster.dbo.ivp_pm_attribute attr\n\ton attr.attribute_id=femd.entity_attribute_id\n\tjoin IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs\n\ton fs.feed_summary_id = femm.feed_summary_id\n\tjoin IVPPriceMasterVendor.dbo.ivp_pm_data_source ds\n\ton ds.data_source_id = fs.data_source_id\n\tjoin #datasources tds\n\ton ds.data_source_name = tds.item\n\twhere ds.is_active = 1 and fs.is_active = 1\n\tand ds.identifier_type_id = 3\n\tand attr.attribute_real_name = 'Mid'\n\tand ltrim(rtrim(femd.feed_field_id)) <> ''\n\n\tinsert into @tempDataSourceBidField (data_source_name, field_mapped_to_bid, primary_fields)\n\tselect data_source_name, femd.feed_field_id, fs.primary_fields \n\tfrom IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm\n\tjoin IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd\n\ton femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id\n\tjoin IVPPriceMaster.dbo.ivp_pm_attribute attr\n\ton attr.attribute_id=femd.entity_attribute_id\n\tjoin IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs\n\ton fs.feed_summary_id = femm.feed_summary_id\n\tjoin IVPPriceMasterVendor.dbo.ivp_pm_data_source ds\n\ton ds.data_source_id = fs.data_source_id\n\tjoin #datasources tds\n\ton ds.data_source_name = tds.item\n\twhere ds.is_active = 1 and fs.is_active = 1\n\tand ds.identifier_type_id = 3\n\tand attr.attribute_real_name = 'Bid'\n\tand ltrim(rtrim(femd.feed_field_id)) <> ''\n\nSELECT @maxCount = count(*) FROM @tempDataSourceMidField\n\nWHILE (@count < @maxCount)\nBEGIN  \n\tSET @count = @count + 1\n\tSELECT @midField = field_mapped_to_mid, @dataSourceName = data_source_name, @primaryFieldName = primary_fields FROM @tempDataSourceMidField WHERE id = @count\n\n\tSELECT @primaryFieldAttribute = attr.attribute_real_name\n\t\t\t\t\t\t\t\t\tFROM IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm\n\t\t\t\t\t\t\t\t\tJOIN IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd\n\t\t\t\t\t\t\t\t\tON femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id\n\t\t\t\t\t\t\t\t\tJOIN IVPPriceMaster.dbo.ivp_pm_attribute attr\n\t\t\t\t\t\t\t\t\tON attr.attribute_id=femd.entity_attribute_id\n\t\t\t\t\t\t\t\t\t--JOIN IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs\n\t\t\t\t\t\t\t\t\t--ON fs.feed_summary_id = femm.feed_summary_id\n\t\t\t\t\t\t\t\t\tJOIN IVPPriceMasterVendor.dbo.ivp_pm_data_source ds\n\t\t\t\t\t\t\t\t\tON ds.data_source_id = femm.data_source_id\n\t\t\t\t\t\t\t\t\tWHERE ds.identifier_type_id = 3\n\t\t\t\t\t\t\t\t\tand femd.is_active = 1\n\t\t\t\t\t\t\t\t\tand ds.data_source_name = @dataSourceName\n\t\t\t\t\t\t\t\t\tAND feed_field_id = @primaryFieldName\n\n\tSET @query = 'SELECT DISTINCT '  + @midField + ', ds.DataSource FROM IVPPriceMasterVendor.dbo.ivp_pmd_feed_standard_dictionary ds ' \n\t\t\t\t+ 'inner join IVPPriceMaster.dbo.ivp_pm_static_security_data sd '\n\t\t\t\t+ 'on ds.' + @primaryFieldName + ' = sd.' + @primaryFieldAttribute\n\t\t\t\t+ ' where ds.DataSource = ''' + @dataSourceName\n\t\