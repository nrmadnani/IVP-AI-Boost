yics_GrandTotal]&nbsp; where business_day_report = @start_business_date order by id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\nEND<br />\nEND<br />\nGO<br />\n<br />\n<br />","description":"Edited by Sreenath Golla","actor_name":"Sreenath Golla","changes":null},{"ixBugEvent":"12161381","event_type":2,"verb":"Edited","actor_person_id":"3923","assigned_to_person_id":"0","datetime":"2024-10-28T16:14:47Z","text":"insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_TotalAssets(business_day_Current,NumberOfCurrentPositions,Market_Value_Current,NAV_Current,business_day_Previous,NumberOfPreviousPositions,Market_Value_Previous,NAV_Previous,business_day_report)  SELECT curr.business_day AS business_day_Current,curr.NumberOfCurrentPositions,curr.Market_Value_Current,curr.NAV_Current, prev.business_day AS business_day_Previous,prev.NumberOfPreviousPositions,IsNull(prev.Market_Value_Previous,0) as Market_Value_Previous,prev.NAV_Previous, cast('2024-07-15' AS VARCHAR)  as business_day_report\n\t\t\t\t\t\t FROM ( SELECT\t'Total' AS Totals,T1.business_day,COUNT(T1.pm_pricing_id) AS NumberOfCurrentPositions,IsNull(@FundMarketValueCurrent,0) AS Market_Value_Current,@TotalNAVCurrent As NAV_Current FROM\t\t@TotalMarketValue T1 WHERE\tT1.business_day = '2024-07-15' GROUP BY T1.business_day ) curr INNER JOIN ( SELECT\t'Total' AS Totals,T1.business_day,COUNT(T1.pm_pricing_id) AS NumberOfPreviousPositions,IsNull(@FundMarketValuePrevious,0) AS Market_Value_Previous,@TotalNAVPrevious As NAV_Previous FROM\t\t@TotalMarketValue T1 WHERE\tT1.business_day = '2024-07-12' GROUP BY T1.business_day )prev ON curr.Totals = prev.Totals\n insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_NetMV(MVCurrent,Market_Value_Current,MVPercent_Current,NAVPercent_Current,MVPrevious,Market_Value_Previous,MVPercent_Previous,NAVPercent_Previous,business_day_report)  SELECT curr.MVCurrent,IsNull(curr.CurrentMarketValue,0) AS Market_Value_Current,curr.MVPercent AS MVPercent_Current,curr.NAVPercent AS NAVPercent_Current, prev.MVPrevious,IsNull(prev.PreviousMarketValue,0) AS Market_Value_Previous,prev.MVPercent AS MVPercent_Previous,prev.NAVPercent AS NAVPercent_Previous, cast('2024-07-15' AS VARCHAR)  as business_day_report\n\t\t\t\t\t\t FROM (  SELECT 'LMV' AS MVCurrent, SUM(Market_Value) as CurrentMarketValue,SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',1 As Priority FROM @TotalMarketValue  WHERE Market_Value >= 0  AND business_day = '2024-07-15' UNION SELECT 'SMV' AS SMV, SUM(Market_Value) as ShortMarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',2 As Priority FROM @TotalMarketValue  WHERE Market_Value < 0  AND business_day = '2024-07-15' )curr  INNER JOIN (  SELECT 'LMV' AS MVPrevious, SUM(Market_Value) as PreviousMarketValue,SUM(Market_Value)/@FundMarketValuePrevious As 'MVPercent',SUM(Market_Value)/@TotalNAVPrevious 'NAVPercent',1 As Priority FROM @TotalMarketValue  WHERE Market_Value >= 0  AND business_day = '2024-07-12' UNION SELECT 'SMV' AS SMV, SUM(Market_Value) as ShortMarketValue, SUM(Market_Value)/@FundMarketValuePrevious As 'MVPercent',SUM(Market_Value)/@TotalNAVPrevious 'NAVPercent',2 As Priority FROM @TotalMarketValue  WHERE Market_Value < 0  AND business_day = '2024-07-12' ) prev ON curr.MVCurrent = prev.MVPrevious ORDER BY curr.[Priority]\n\t\t\t\t\t\t insert into IVPPriceMaster.dbo.PM_PricingSourceAnalytics_SourceType([Source_Type_Current],[Pricing_Source_Selected_Current],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[Priority_Current],[Source_Type_Previous],[Pricing_Source_Selected_Previous],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous],business_day_report) SELECT curr.Source_Type AS Source_Type_Current,curr.Pricing_Source_Selected As Pricing_Source_Selected_Current,curr.TotalCount AS TotalCount_Current,IsNull(curr.MarketValue,0) AS MarketValue_Current, curr.MVPercent AS MVPercent_Current,curr.NAVPercent AS NAVPercent_Current,curr.[Priority] AS Priority_Current,  prev.Source_Type AS Source_Type_Previous,prev.Pricing_Source_Selected As Pricing_Source_Selected_Previous,prev.TotalCount AS TotalCount_Previous,IsNull(prev.MarketValue,0) AS MarketValue_Previous, prev.MVPercent AS MVPercent_Previous,prev.NAVPercent AS NAVPercent_Previous,prev.[Priority] AS Priority_Previous,  cast('2024-07-15' AS VARCHAR)  as business_day_report\n\t\t\t\t\t\t FROM ( SELECT 'Vendor' As Source_Type,Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',1 As [Priority] \n\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-15' AND ISNULL(NULLIF(Pricing_Source_Selected,''),'Broker') <> 'Broker' GROUP BY Pricing_Source_Selected  UNION SELECT 'Broker' AS Source_Type,'Broker' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',2 As [Priority] \n\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-15' AND NULLIF(Pricing_Source_Selected,'') = 'Broker' UNION SELECT 'Others' AS Source_Type,'Others' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',3 As [Priority] \n\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-15' AND NULLIF(Pricing_Source_Selected,'') IS NULL  )curr  INNER JOIN ( SELECT 'Vendor' As Source_Type,Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',1 As [Priority]\n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-12' AND ISNULL(NULLIF(Pricing_Source_Selected,''),'Broker') <> 'Broker'\n\t\t\t\t\t\t\t\t\t\t   GROUP BY Pricing_Source_Selected  UNION SELECT 'Broker' AS Source_Type,'Broker' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',2 As [Priority]  \n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-12' AND NULLIF(Pricing_Source_Selected,'') = 'Broker' UNION SELECT 'Others' AS Source_Type,'Others' AS Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent',3 As [Priority]  \n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-12' AND NULLIF(Pricing_Source_Selected,'') IS NULL  )prev ON curr.Pricing_Source_Selected = prev.Pricing_Source_Selected ORDER BY curr.[Priority]\n\t\t\t\t\t\t\t\t\t\t   insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_GrandTotal([GrandTotalCurrent],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[GrandTotalPrevious],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous],business_day_report) SELECT curr.GrandTotalCurrent,curr.TotalCount_Current,curr.Market_Value_Current,curr.MVPercent_Current,curr.NAVPercent_Current, prev.GrandTotalPrevious,prev.TotalCount_Previous,prev.Market_Value_Previous,prev.MVPercent_Previous,prev.NAVPercent_Previous, cast('2024-07-15' AS VARCHAR)  as business_day_report\n\t\t\t\t\t\t FROM ( SELECT 'GrandTotal' AS GrandTotalCurrent,COUNT(*) AS TotalCount_Current,SUM(Market_Value) as Market_Value_Current, SUM(Market_Value)/@FundMarketValueCurrent As 'MVPercent_Current',SUM(Market_Value)/@TotalNAVCurrent 'NAVPercent_Current' \n\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-15' )curr INNER JOIN ( SELECT 'GrandTotal' AS GrandTotalPrevious,COUNT(*) AS TotalCount_Previous,SUM(Market_Value) as Market_Value_Previous, SUM(Market_Value)/@FundMarketValuePrevious As 'MVPercent_Previous',SUM(Market_Value)/@TotalNAVPrevious 'NAVPercent_Previous' \n\t\t\t\t\t\t\t\t\t\t   FROM @TotalMarketValue\n\t\t\t\t\t\t\t\t\t\t   WHERE business_day = '2024-07-12' )prev ON curr.GrandTotalCurrent = prev.GrandTotalPrevious","html":"insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_TotalAssets(business_day_Current,NumberOfCurrentPositions,Market_Value_Current,NAV_Current,business_day_Previous,NumberOfPreviousPositions,Market_Value_Previous,NAV_Previous,business_day_report)&nbsp; SELECT curr.business_day AS business_day_Current,curr.NumberOfCurrentPositions,curr.Market_Value_Current,curr.NAV_Current, prev.business_day AS business_day_Previous,prev.NumberOfPreviousPositions,IsNull(prev.Market_Value_Previous,0) as Market_Value_Previous,prev.NAV_Previous, cast(&#39;2024-07-15&#39; AS VARCHAR)&nbsp; as business_day_report<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; FROM ( SELECT&nbsp;&nbsp;&nbsp;&nbsp;&#39;Total&#39; AS Totals,T1.business_day,COUNT(T1.pm_pricing_id) AS NumberOfCurrentPositions,IsNull(@FundMarketValueCurrent,0) AS Market_Value_Current,@TotalNAVCurrent As NAV_Current FROM&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@TotalMarketValue T1 WHERE&nbsp;&nbsp;&nbsp;&nbsp;T1.business_day = &#39;2024-07-15&#39; GROUP BY T1.business_day ) curr INNER JOIN ( SELECT&nbsp;&nbsp;&nbsp;&nbsp;&#39;Total&#39; AS Totals,T1.business_day,COUNT(T1.pm_pricing_id) AS NumberOfPreviousPositions,IsNull(@FundMarketValuePrevious,0) AS Market_Value_Previous,@TotalNAVPrevious As NAV_Previous FROM&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@TotalMarketValue T1 WHERE&nbsp;&nbsp;&nbsp;&nbsp;T1.business_day = &#39;2024-07-12&#39; GROUP BY T1.business_day )prev ON curr.Totals = prev.Totals<br />\n&nbsp;insert into IVPPriceMaster.dbo.PM_PricingSourceAnaltyics_NetMV(MVCurrent,Market_Value_Current,MVPercent_Current,NAVPercent_Current,MVPrevious,Market_Value_Previous,MVPercent_Previous,NAVPercent_Previous,business_day_report)&nbsp; SELECT curr.MVCurrent,IsNull(curr.CurrentMarketValue,0) AS Market_Value_Current,curr.MVPercent AS MVPercent_Current,curr.NAVPercent AS NAVPercent_Current, prev.MVPrevious,IsNull(prev.PreviousMarketValue,0) AS Market_Value_Previous,prev.MVPercent AS MVPercent_Previous,prev.NAVPercent AS NAVPercent_Previous, cast(&#39;2024-07-15&#39; AS VARCHAR)&nbsp; as business_day_report<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; FROM (&nbsp; SELECT &#39;LMV&#39; AS MVCurrent, SUM(Market_Value) as CurrentMarketValue,SUM(Market_Value)/@FundMarketValueCurrent As &#39;MVPercent&#39;,SUM(Market_Value)/@TotalNAVCurrent &#39;NAVPercent&#39;,1 As Priority FROM @TotalMarketValue&nbsp; WHERE Market_Value &gt;= 0&nbsp; AND business_day = &#39;2024-07-15&#39; UNION SELECT &#39;SMV&#39; AS SMV, SUM(Market_Value) as ShortMarketValue, SUM(Market_Value)/@FundMarketValueCurrent As &#39;MVPercent&#39;,SUM(Market_Value)/@TotalNAVCurrent &#39;NAVPercent&#39;,2 As Priority FROM @TotalMarketValue&nbsp; WHERE Market_Value &lt; 0&nbsp; AND business_day = &#39;2024-07-15&#39; )curr&nbsp; INNER JOIN (&nbsp; SELECT &#39;LMV&#39; AS MVPrevious, SUM(Market_Value) as PreviousMarketValue,SUM(Market_Value)/@FundMarketValuePrevious As &#39;MVPercent&#39;,SUM(Market_Value)/@TotalNAVPrevious &#39;NAVPercent&#39;,1 As Priority FROM @TotalMarketValue&nbsp; WHERE Market_Value &gt;= 0&nbsp; AND business_day = &#39;2024-07-12&#39; UNION SELECT &#39;SMV&#39; AS SMV, SUM(Market_Value) as ShortMarketValue, SUM(Market_Value)/@FundMarketValuePrevious As &#39;MVPercent&#39;,SUM(Market_Value)/@TotalNAVPrevious &#39;NAVPercent&#39;,2 As Priority FROM @TotalMarketValue&nbsp; WHERE Market_Value &lt; 0&nbsp; AND business_day = &#39;2024-07-12&#39; ) prev ON curr.MVCurrent = prev.MVPrevious ORDER BY curr.[Priority]<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; insert into IVPPriceMaster.dbo.PM_PricingSourceAnalytics_SourceType([Source_Type_Current],[Pricing_Source_Selected_Current],[TotalCount_Current],[Market_Value_Current],[MVPercent_Current],[NAVPercent_Current],[Priority_Current],[Source_Type_Previous],[Pricing_Source_Selected_Previous],[TotalCount_Previous],[Market_Value_Previous],[MVPercent_Previous],[NAVPercent_Previous],business_day_report) SELECT curr.Source_Type AS Source_Type_Current,curr.Pricing_Source_Selected As Pricing_Source_Selected_Current,curr.TotalCount AS TotalCount_Current,IsNull(curr.MarketValue,0) AS MarketValue_Current, curr.MVPercent AS MVPercent_Current,curr.NAVPercent AS NAVPercent_Current,curr.[Priority] AS Priority_Current,&nbsp; prev.Source_Type AS Source_Type_Previous,prev.Pricing_Source_Selected As Pricing_Source_Selected_Previous,prev.TotalCount AS TotalCount_Previous,IsNull(prev.MarketValue,0) AS MarketValue_Previous, prev.MVPercent AS MVPercent_Previous,prev.NAVPercent AS NAVPercent_Previous,prev.[Priority] AS Priority_Previous,&nbsp; cast(&#39;2024-07-15&#39; AS VARCHAR)&nbsp; as business_day_report<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; FROM ( SELECT &#39;Vendor&#39; As Source_Type,Pricing_Source_Selected,COUNT(*) AS TotalCount,SUM(Market_Value) as MarketValue, SUM(Market_Value)/@FundMarketValueCurrent As &#39;MVPercent&#39;,SUM(Market_Value)/@TotalNAVCurrent &#39;NAVPercent&#39;,1 As [Priority] <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;