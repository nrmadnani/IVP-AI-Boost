businessDay;\n\n    DROP TABLE #tempPricingID;\n    DROP TABLE #tempMaxBusinessDay;\nEND;\nGO","html":"USE [IVPPriceMaster]<br />\nGO<br />\n<br />\n/****** Object:&nbsp; StoredProcedure [dbo].[IMPL_PM_GetPreviousDayData]&nbsp; &nbsp; Script Date: 7/9/2025 12:53:14 PM ******/<br />\nSET ANSI_NULLS ON<br />\nGO<br />\n<br />\nSET QUOTED_IDENTIFIER ON<br />\nGO<br />\n<br />\n<br />\nCREATE OR ALTER PROCEDURE [dbo].[IMPL_PM_GetPreviousDayData]<br />\n&nbsp; &nbsp; @businessDay&nbsp; &nbsp; VARCHAR(200),<br />\n&nbsp; &nbsp; @pmPricingIds&nbsp; &nbsp; VARCHAR(MAX),<br />\n&nbsp; &nbsp; @pricingListId&nbsp; VARCHAR(100)<br />\nAS<br />\nBEGIN<br />\n&nbsp; &nbsp; SET NOCOUNT ON;<br />\n<br />\n&nbsp; &nbsp; DECLARE @sqlQuery NVARCHAR(MAX);<br />\n<br />\n&nbsp; &nbsp; CREATE TABLE #tempPricingID (<br />\n&nbsp; &nbsp; &nbsp; &nbsp; pm_pricing_id VARCHAR(100) PRIMARY KEY<br />\n&nbsp; &nbsp; );<br />\n<br />\n&nbsp; &nbsp; CREATE TABLE #tempMaxBusinessDay (<br />\n&nbsp; &nbsp; &nbsp; &nbsp; pm_pricing_id VARCHAR(100) PRIMARY KEY,<br />\n&nbsp; &nbsp; &nbsp; &nbsp; max_business_day DATETIME<br />\n&nbsp; &nbsp; );<br />\n<br />\n&nbsp; &nbsp; CREATE NONCLUSTERED INDEX IX_max_business_day ON #tempMaxBusinessDay(max_business_day);<br />\n<br />\n&nbsp;<br />\n&nbsp; &nbsp; INSERT INTO #tempPricingID(pm_pricing_id)<br />\n&nbsp; &nbsp; SELECT item<br />\n&nbsp; &nbsp; FROM ivprad.dbo.RAD_GetSplittedList(@pmPricingIds, &#39;,&#39;);<br />\n<br />\n&nbsp;  <br />\n&nbsp; &nbsp; SET @sqlQuery = &#39;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; INSERT INTO #tempMaxBusinessDay(pm_pricing_id, max_business_day)<br />\n&nbsp; &nbsp; &nbsp; &nbsp; SELECT temp.pm_pricing_id, MAX(PL.business_day)<br />\n&nbsp; &nbsp; &nbsp; &nbsp; FROM #tempPricingID temp<br />\n&nbsp; &nbsp; &nbsp; &nbsp; INNER JOIN IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_&#39; + QUOTENAME(@pricingListId) + &#39; PL<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ON temp.pm_pricing_id = PL.pm_pricing_id<br />\n&nbsp; &