IVPPriceMasterVendor.dbo.ivp_pm_data_source ds\n              on ds.data_source_id = fs.data_source_id inner join IVPPriceMaster.dbo.ivp_pm_pricing_list_datasource plds \n\t          on plds.datasource_id=ds.data_source_id\n              where plds.pricing_list_id=@pricing_list_id and plds.is_active=1 and ds.is_active = 1 and fs.is_active = 1\n              AND femd.is_active = 1  \n              and attr.attribute_real_name = 'Current_Mark'\n              and ltrim(rtrim(femd.feed_field_id)) <> ''\n\t\t\t  PRINT('AFTER FETCHING DATA SOURCES LIST'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  \n\n\t\t\t  SELECT @max_data_source_count = COUNT(*) FROM #data_sources_list\n\t\t\t  --loop on datasources\n\t\t\t  WHILE(@data_source_count <= @max_data_source_count)\n\t\t\t  BEGIN\n\t\t\t  select @data_source_feed_table_name=data_source_table_name,@security_mapping_table_name=security_mapping_table_name,@price_column=field_mapped_to_current_mark,@data_source_name=data_source_name\n\t\t\t  from #data_sources_list\n\t\t\t  where id = @data_source_count\n\n\t\t\t  PRINT('BEFORE JOINING FEED,SEC MAP,PRICE LIST'+CONVERT(VARCHAR(19),GETDATE(),120))\n\n\t\t\t  SET @query = 'SELECT smd.pm_security_id,smd.security_primary_key,feed.DataSource,feed.'+@price_column+',pl.Current_Mark,pl.last_modified_on,pl.business_day,pl.archive_id\n                           FROM IVPPriceMasterVendor.dbo.'+@data_source_feed_table_name+' feed inner join IVPPriceMasterVendor.dbo.'+@security_mapping_table_name+' smd\n\t\t\t\t\t\t   on feed.id = smd.id and feed.DataSource = smd.DataSource and feed.business_day=smd.business_day inner join IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_' + CAST(@pricing_list_id AS NVARCHAR) + ' pl\n\t\t\t\t\t\t   on pl.pm_security_id = smd.pm_security_id and smd.business_day = pl.business_day\n                           WHERE feed.is_latest=1 and feed.DataSource='''+@data_source_name+''' AND smd.DataSource='''+@data_source_name+''' AND feed.business_day = '''+cast(@business_day as varchar) + ''' AND pl.business_day = '''+cast(@business_day as varchar) + ''' AND smd.business_day = '''+cast(@business_day as varchar) + '''\n                           AND pl.action_column <> ''D''\n\t\t                   ORDER BY pl.pm_security_id,pl.archive_id';\n\n\t\t\t\t\t\t   print(@query)\n\t\t\t\t\t\t   INSERT INTO #data_source_price_list_data(pm_security_id,Primary_key,Datasource,Datasource_Mark,Current_Mark,last_modified_on,business_day,archive_id)\n\t\t\t\t\t\t   EXEC(@query)\n\t\t\t PRINT('AFTER JOINING FEED,SEC MAP,PRICE LIST'+CONVERT(VARCHAR(19),GETDATE(),120))\n\n\t\t\t\t\t\t   SET @query=''\n\t\t\t\t\t\t   SET @data_source_feed_table_name=''\n\t\t\t\t\t\t   SET @security_mapping_table_name=''\n\t\t\t\t\t\t   SET @price_column=''\n\t\t\t\t\t\t   --SET @primary_column=''\n\t\t\t\t\t\t   SET @data_source_count = @data_source_count+1\n\t\t\t \n\t\t\t  END\n\t\t\t  --loop on datasources end\n\t\t\t  --changes\n\t\t\t \n\t\t\t  --START TIME AND END TIME IS NULL\n\t\t\t  --IF(@start_time = '' and @end_time = '')\n\t\t\t  --BEGIN\n\t\t\t  -- PRINT('BEFORE PRICE LIST SELF JOIN START TIME AND END TIME IS NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  --insert into #data_source_price_list_final_data\n\t\t\t  --SELECT pd1.pm_security_id,pd1.Primary_key,pd1.Datasource,pd1.Datasource_Mark, pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id\n\t\t\t  --FROM #data_source_price_list_data pd1 left outer join #data_source_price_list_data pd2\n\t\t\t  --ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id\n\t\t\t  --WHERE CAST(PD1.last_modified_on AS DATE) = '' + CAST(@last_modified_on AS NVARCHAR) + ''\n\t\t\t  --PRINT('AFTER PRICE LIST SELF JOIN START TIME AND END TIME IS NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  --END\n\t\t\t  ----START TIME IS NULL\n\t\t\t  --ELSE IF(@start_time = '')\n\t\t\t  --BEGIN\n\t\t\t  --PRINT('BEFORE PRICE LIST SELF JOIN START TIME IS NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  --insert into #data_source_price_list_final_data\n\t\t\t  --SELECT pd1.pm_security_id,pd1.Primary_key,pd1.Datasource,pd1.Datasource_Mark, pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id\n\t\t\t  --FROM #data_source_price_list_data pd1 left outer join #data_source_price_list_data pd2\n\t\t\t  --ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id\n\t\t\t  --WHERE CAST(PD1.last_modified_on AS DATE) = '' + CAST(@last_modified_on AS NVARCHAR) + ''\n\t\t\t  --AND CAST(PD1.last_modified_on AS TIME) <= '' + CAST(@end_time AS NVARCHAR) + ''\n\t\t\t  -- PRINT('AFTER PRICE LIST SELF JOIN START TIME IS NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  --END\n\t\t\t  ----END TIME IS NULL\n\t\t\t  --ELSE IF(@end_time = '')\n\t\t\t  --BEGIN\n\t\t\t  -- PRINT('BEFORE PRICE LIST SELF JOIN END TIME IS NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  --insert into #data_source_price_list_final_data\n\t\t\t  --SELECT pd1.pm_security_id,pd1.Primary_key, pd1.Datasource,pd1.Datasource_Mark,pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id\n\t\t\t  --FROM #data_source_price_list_data pd1 left outer join #data_source_price_list_data pd2\n\t\t\t  --ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id\n\t\t\t  --WHERE CAST(PD1.last_modified_on AS DATE) = '' + CAST(@last_modified_on AS NVARCHAR) + ''\n\t\t\t  --AND CAST(PD1.last_modified_on AS TIME) >= '' + CAST(@start_time AS NVARCHAR) + ''\n\t\t\t  -- PRINT('AFTER PRICE LIST SELF JOIN START TIME IS NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  --END\n\t\t\t  --BOTH START TIME AND END TIME IS NOT NULL AND START TIME <= END TIME\n\t\t\t  IF(@start_time <= @end_time)\n\t\t\t  BEGIN\n\t\t\t   PRINT('BEFORE PRICE LIST SELF JOIN START TIME AND END TIME IS NOT NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t\t  insert into #data_source_price_list_final_data\n\t\t\t  SELECT pd1.pm_security_id,pd1.Primary_key,pd1.Datasource,pd1.Datasource_Mark, pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id\n\t\t\t  FROM #data_source_price_list_data pd1 inner join #data_source_price_list_data pd2\n\t\t\t  ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id\n\t\t\t  WHERE CAST(PD1.last_modified_on AS DATE) =  CAST(@last_modified_on AS NVARCHAR) \n              AND CAST(PD1.last_modified_on AS TIME) >= CAST(@start_time AS NVARCHAR) \n              AND CAST(PD1.last_modified_on AS TIME) <=  CAST(@end_time AS NVARCHAR) \n\t\t\t   PRINT('AFTER PRICE LIST SELF JOIN START TIME AND END TIME IS NOT NULL'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t\t      END\n\t\t\n\t\t\t -- WHERE pd1.Current_Mark <> pd2.Current_Mark\n\n\t\t\t SET @count = @count+1\n\t\t\t SET @data_source_count=1\n\t\t\t SET @max_data_source_count=0\n\t\t\t DROP TABLE #data_sources_list\n\t\t\t  \n\tend\n\n\n\t--PRINT('BEFORE FINAL DATA'+CONVERT(VARCHAR(19),GETDATE(),120))\n\t--insert into #finalData\n\t--SELECT CAST(PD.business_day as date),CUSIP,Bond_Name,pd.Datasource,pd.Datasource_Mark,Current_Mark,Updated_Time,Last_Mark,Last_Updated_Time\n\t--FROM #staticSecurityData SD JOIN #data_source_price_list_final_data PD\n\t--ON SD.pm_security_id = PD.pm_security_id\n\t--PRINT('AFTER FINAL DATA'+CONVERT(VARCHAR(19),GETDATE(),120))\n\n\tALTER TABLE #data_source_price_list_final_data ADD [NEW/REVISED] VARCHAR(10)\n\n\n\t\n\tUPDATE #data_source_price_list_final_data\n\tSET [NEW/REVISED] = CASE WHEN Last_Mark IS NULL  THEN 'NEW' ELSE 'REVISED'\n\tEND\n\n\tINSERT INTO #finalData([As of Date], CUSIP,pm_security_id,Datasource,DataSource_Mark,Mark,[Update Time],[Last Mark],[Last Updated Time],[NEW/REVISED])\n\tselect cast(business_day as date),Primary_key,pm_security_id,Datasource,Datasource_Mark,Current_Mark,Updated_Time,Last_Mark,Last_Updated_Time,[NEW/REVISED]\n\tfrom #data_source_price_list_final_data\n\t\n\t\n\tSELECT *\n\tFROM #finalData \n\tWHERE MARK IS NOT NULL\n\torder by [update time] desc --ORDER BY CASE WHEN [NEW/REVISED] = 'REVISED' THEN 0 WHEN [NEW/REVISED] = 'NEW' THEN 1 END,[Update Time] DESC\n\n\t--DROP INDEX #staticSecurityData.IDX_STATIC_SECURITY_ID\n\t--DROP INDEX #staticSecurityData.IDX_STATIC_SECURITY_PM_SEC_ID\n\tDROP INDEX #data_source_price_list_data.IDX_PRICE_LIST_ID\n\tDROP INDEX #data_source_price_list_data.IDX_PRICE_LIST_PM_SEC_ID\n\tDROP INDEX #data_source_price_list_final_data.IDX_PRICE_LIST_FINAL_ID\n\n\tDROP TABLE #finalData\n\tDROP TABLE #data_source_price_list_final_data\n\tDROP TABLE #data_source_price_list_data\n\t--DROP TABLE #staticSecurityData\n\t\n\t\nEND\n\n\n\nGO","html":"USE [IVPPriceMaster]<br />\nGO<br />\n<br />\n/****** Object:&nbsp; StoredProcedure [dbo].[ivp_pm_get_custom_price_change_report]&nbsp; &nbsp; Script Date: 6/19/2024 6:29:24 PM ******/<br />\nSET ANSI_NULLS ON<br />\nGO<br />\n<br />\nSET QUOTED_IDENTIFIER ON<br />\nGO<br />\n<br />\n<br />\n<br />\n<br />\n<br />\n<br />\n<br />\nCREATE OR ALTER&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  PROC [dbo].[ivp_pm_get_custom_price_change_report_new_changes](<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@business_day DATETIME,<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@last_modified_on DATE,<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@start_time TIME,<br />\n&nbsp;&nbsp;&nbsp;&nbsp;@end_time TIME<br />\n)<br />\nAS<br />\nBEGIN<br />\n<br />\n&nbsp; &nbsp; DECLARE @query VARCHAR(MAX) = &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @max_count INT = 0<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @count INT = 0<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @pricing_list_id INT<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @data_source_feed_table_name varchar(500)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @security_mapping_table_name varchar(500)<br />\n&nbsp; &nbsp; DECLARE @price_column varchar(200)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--DECLARE @primary_column varchar(200)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @data_source_name varchar(200)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @data_source_count int = 1<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DECLARE @max_data_source_count int = 0<br />\n<br />\n&nbsp; &nbsp; DECLARE @pricinglist_list Table(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;id INT IDENTITY(1,1), pricing_list_id INT<br />\n&nbsp;&nbsp;&nbsp;&nbsp;)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--CREATE TABLE #staticSecurityData (<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--&nbsp;&nbsp;&nbsp;&nbsp;id int identity(1,1),pm_security_id VARCHAR(200), CUSIP VARCHAR(200), Bond_Name VARCHAR(2000)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CREATE TABLE #data_source_price_list_data(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;id int identity(1,1),pm_security_id VARCHAR(200),Primary_key varchar(500),Datasource varchar(200),Datasource_Mark DECIMAL(28,2), Current_Mark DECIMAL(28,2),last_modified_on datetime,business_day datetime,archive_id int<br />\n&nbsp;&nbsp;&nbsp;&nbsp;)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CREATE TABLE #data_source_price_list_final_data(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;pm_security_id VARCHAR(200),Primary_key varchar(500),Datasource varchar(200),Datasource_Mark DECIMAL(28,2), Current_Mark DECIMAL(28,2),Updated_Time DATETIME,Last_Mark Decimal(28,2),Last_Updated_Time datetime,business_day datetime,archive_id int<br />\n&nbsp;&nbsp;&nbsp;&nbsp;)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CREATE TABLE #finalData (<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;pm_pricing_id int identity(1,1),[As of Date] date, CUSIP VARCHAR(200),pm_security_id varchar(200),Datasource varchar(200),DataSource_Mark DECIMAL(28,2), Mark DECIMAL(28,2),[Update Time] DATETIME,[Last Mark] DECIMAL(28,2),[Last Updated Time] datetime,[NEW/REVISED] varchar(10)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--indexes creation<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--CREATE CLUSTERED INDEX IDX_STATIC_SECURITY_ID ON #staticSecurityData(id)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--CREATE NONCLUSTERED INDEX IDX_STATIC_SECURITY_PM_SEC_ID ON #staticSecurityData(pm_security_id)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CREATE CLUSTERED INDEX IDX_PRICE_LIST_ID ON #data_source_price_list_data(id)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CREATE NONCLUSTERED INDEX IDX_PRICE_LIST_PM_SEC_ID ON #data_source_price_list_data(pm_security_id)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;CREATE CLUSTERED INDEX IDX_PRICE_LIST_FINAL_ID ON #data_source_price_list_final_data(pm_security_id)<br />\n<br />\n<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--fetch the pricing list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;INSERT INTO @pricinglist_list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;SELECT pricing_list_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;FROM IVPPriceMaster.dbo.ivp_pm_pricing_list <br />\n&nbsp;&nbsp;&nbsp;&nbsp;WHERE is_active=1 and pricing_list_name in (&#39;Private Fund Monthly&#39;)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--fetch the static data based on last_modified_on date,start and end time<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--INSERT INTO #staticSecurityData<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--SELECT pm_security_id,cusip,Description<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--FROM IVPPriceMaster_Archive.dbo.ivp_pm_static_security_data WITH (NOLOCK)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--WHERE business_day = @business_day and is_active=1 and is_latest=1 <br />\n&nbsp;&nbsp;&nbsp;&nbsp;--ORDER BY pm_security_id,archive_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;SELECT @count = 1<br />\n&nbsp;&nbsp;&nbsp;&nbsp;SELECT @max_count = count(*) FROM @pricinglist_list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--loop on pricing list ids<br />\n&nbsp;&nbsp;&nbsp;&nbsp;WHILE(@count &lt;= @max_count)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;BEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SELECT @pricing_list_id = pricing_list_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;FROM @pricinglist_list <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;WHERE id = @count<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --changes<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --fetching feed table,sec table,ds name,current_mark attribute<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  CREATE TABLE #data_sources_list(<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; id int identity(1,1),data_source_name varchar(200),data_source_table_name varchar(max),security_mapping_table_name varchar(max),field_mapped_to_current_mark varchar(max),primary_fields varchar(max))<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PRINT(&#39;BEFORE FETCHING DATA SOURCES LIST&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; insert into #data_sources_list (data_source_name,data_source_table_name,security_mapping_table_name,field_mapped_to_current_mark, primary_fields)<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; select data_source_name,data_source_table_name,security_mapping_table, femd.feed_field_id, fs.primary_fields<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; from IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; join IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; on femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; join IVPPriceMaster.dbo.ivp_pm_attribute attr<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; on attr.attribute_id=femd.entity_attribute_id<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; join IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; on fs.feed_summary_id = femm.feed_summary_id<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; join IVPPriceMasterVendor.dbo.ivp_pm_data_source ds<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; on ds.data_source_id = fs.data_source_id inner join IVPPriceMaster.dbo.ivp_pm_pricing_list_datasource plds <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; on plds.datasource_id=ds.data_source_id<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; where plds.pricing_list_id=@pricing_list_id and plds.is_active=1 and ds.is_active = 1 and fs.is_active = 1<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; AND femd.is_active = 1&nbsp; <br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; and attr.attribute_real_name = &#39;Current_Mark&#39;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; and ltrim(rtrim(femd.feed_field_id)) &lt;&gt; &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PRINT(&#39;AFTER FETCHING DATA SOURCES LIST&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SELECT @max_data_source_count = COUNT(*) FROM #data_sources_list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --loop on datasources<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; WHILE(@data_source_count &lt;= @max_data_source_count)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; BEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; select @data_source_feed_table_name=data_source_table_name,@security_mapping_table_name=security_mapping_table_name,@price_column=field_mapped_to_current_mark,@data_source_name=data_source_name<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; from #data_sources_list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; where id = @data_source_count<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PRINT(&#39;BEFORE JOINING FEED,SEC MAP,PRICE LIST&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SET @query = &#39;SELECT smd.pm_security_id,smd.security_primary_key,feed.DataSource,feed.&#39;+@price_column+&#39;,pl.Current_Mark,pl.last_modified_on,pl.business_day,pl.archive_id<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  FROM IVPPriceMasterVendor.dbo.&#39;+@data_source_feed_table_name+&#39; feed inner join IVPPriceMasterVendor.dbo.&#39;+@security_mapping_table_name+&#39; smd<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  on feed.id = smd.id and feed.DataSource = smd.DataSource and feed.business_day=smd.business_day inner join IVPPriceMaster_Archive.dbo.ivp_pmd_price_list_&#39; + CAST(@pricing_list_id AS NVARCHAR) + &#39; pl<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  on pl.pm_security_id = smd.pm_security_id and smd.business_day = pl.business_day<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  WHERE feed.is_latest=1 and feed.DataSource=&#39;&#39;&#39;+@data_source_name+&#39;&#39;&#39; AND smd.DataSource=&#39;&#39;&#39;+@data_source_name+&#39;&#39;&#39; AND feed.business_day = &#39;&#39;&#39;+cast(@business_day as varchar) + &#39;&#39;&#39; AND pl.business_day = &#39;&#39;&#39;+cast(@business_day as varchar) + &#39;&#39;&#39; AND smd.business_day = &#39;&#39;&#39;+cast(@business_day as varchar) + &#39;&#39;&#39;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  AND pl.action_column &lt;&gt; &#39;&#39;D&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;  ORDER BY pl.pm_security_id,pl.archive_id&#39;;<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  print(@query)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  INSERT INTO #data_source_price_list_data(pm_security_id,Primary_key,Datasource,Datasource_Mark,Current_Mark,last_modified_on,business_day,archive_id)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  EXEC(@query)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PRINT(&#39;AFTER JOINING FEED,SEC MAP,PRICE LIST&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  SET @query=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  SET @data_source_feed_table_name=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  SET @security_mapping_table_name=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  SET @price_column=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  --SET @primary_column=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  SET @data_source_count = @data_source_count+1<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; END<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --loop on datasources end<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --changes<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --START TIME AND END TIME IS NULL<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --IF(@start_time = &#39;&#39; and @end_time = &#39;&#39;)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --BEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; -- PRINT(&#39;BEFORE PRICE LIST SELF JOIN START TIME AND END TIME IS NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --insert into #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --SELECT pd1.pm_security_id,pd1.Primary_key,pd1.Datasource,pd1.Datasource_Mark, pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --FROM #data_source_price_list_data pd1 left outer join #data_source_price_list_data pd2<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --WHERE CAST(PD1.last_modified_on AS DATE) = &#39;&#39; + CAST(@last_modified_on AS NVARCHAR) + &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --PRINT(&#39;AFTER PRICE LIST SELF JOIN START TIME AND END TIME IS NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --END<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ----START TIME IS NULL<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --ELSE IF(@start_time = &#39;&#39;)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --BEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --PRINT(&#39;BEFORE PRICE LIST SELF JOIN START TIME IS NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --insert into #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --SELECT pd1.pm_security_id,pd1.Primary_key,pd1.Datasource,pd1.Datasource_Mark, pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --FROM #data_source_price_list_data pd1 left outer join #data_source_price_list_data pd2<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --WHERE CAST(PD1.last_modified_on AS DATE) = &#39;&#39; + CAST(@last_modified_on AS NVARCHAR) + &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --AND CAST(PD1.last_modified_on AS TIME) &lt;= &#39;&#39; + CAST(@end_time AS NVARCHAR) + &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; -- PRINT(&#39;AFTER PRICE LIST SELF JOIN START TIME IS NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --END<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ----END TIME IS NULL<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --ELSE IF(@end_time = &#39;&#39;)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --BEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; -- PRINT(&#39;BEFORE PRICE LIST SELF JOIN END TIME IS NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --insert into #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --SELECT pd1.pm_security_id,pd1.Primary_key, pd1.Datasource,pd1.Datasource_Mark,pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --FROM #data_source_price_list_data pd1 left outer join #data_source_price_list_data pd2<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --WHERE CAST(PD1.last_modified_on AS DATE) = &#39;&#39; + CAST(@last_modified_on AS NVARCHAR) + &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --AND CAST(PD1.last_modified_on AS TIME) &gt;= &#39;&#39; + CAST(@start_time AS NVARCHAR) + &#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; -- PRINT(&#39;AFTER PRICE LIST SELF JOIN START TIME IS NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --END<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --BOTH START TIME AND END TIME IS NOT NULL AND START TIME &lt;= END TIME<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; IF(@start_time &lt;= @end_time)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; BEGIN<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  PRINT(&#39;BEFORE PRICE LIST SELF JOIN START TIME AND END TIME IS NOT NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; insert into #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SELECT pd1.pm_security_id,pd1.Primary_key,pd1.Datasource,pd1.Datasource_Mark, pd1.Current_Mark,pd1.last_modified_on,pd2.Current_Mark,pd2.last_modified_on,pd1.business_day,pd1.archive_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; FROM #data_source_price_list_data pd1 inner join #data_source_price_list_data pd2<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ON pd1.id = (pd2.id+1) and pd1.pm_security_id=pd2.pm_security_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; WHERE CAST(PD1.last_modified_on AS DATE) =&nbsp; CAST(@last_modified_on AS NVARCHAR) <br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; AND CAST(PD1.last_modified_on AS TIME) &gt;= CAST(@start_time AS NVARCHAR) <br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; AND CAST(PD1.last_modified_on AS TIME) &lt;=&nbsp; CAST(@end_time AS NVARCHAR) <br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  PRINT(&#39;AFTER PRICE LIST SELF JOIN START TIME AND END TIME IS NOT NULL&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; END<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; -- WHERE pd1.Current_Mark &lt;&gt; pd2.Current_Mark<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SET @count = @count+1<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SET @data_source_count=1<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SET @max_data_source_count=0<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; DROP TABLE #data_sources_list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />\n&nbsp;&nbsp;&nbsp;&nbsp;end<br />\n<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--PRINT(&#39;BEFORE FINAL DATA&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--insert into #finalData<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--SELECT CAST(PD.business_day as date),CUSIP,Bond_Name,pd.Datasource,pd.Datasource_Mark,Current_Mark,Updated_Time,Last_Mark,Last_Updated_Time<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--FROM #staticSecurityData SD JOIN #data_source_price_list_final_data PD<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--ON SD.pm_security_id = PD.pm_security_id<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--PRINT(&#39;AFTER FINAL DATA&#39;+CONVERT(VARCHAR(19),GETDATE(),120))<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;ALTER TABLE #data_source_price_list_final_data ADD [NEW/REVISED] VARCHAR(10)<br />\n<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;UPDATE #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;SET [NEW/REVISED] = CASE WHEN Last_Mark IS NULL&nbsp; THEN &#39;NEW&#39; ELSE &#39;REVISED&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;END<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;INSERT INTO #finalData([As of Date], CUSIP,pm_security_id,Datasource,DataSource_Mark,Mark,[Update Time],[Last Mark],[Last Updated Time],[NEW/REVISED])<br />\n&nbsp;&nbsp;&nbsp;&nbsp;select cast(business_day as date),Primary_key,pm_security_id,Datasource,Datasource_Mark,Current_Mark,Updated_Time,Last_Mark,Last_Updated_Time,[NEW/REVISED]<br />\n&nbsp;&nbsp;&nbsp;&nbsp;from #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;SELECT *<br />\n&nbsp;&nbsp;&nbsp;&nbsp;FROM #finalData <br />\n&nbsp;&nbsp;&nbsp;&nbsp;WHERE MARK IS NOT NULL<br />\n&nbsp;&nbsp;&nbsp;&nbsp;order by [update time] desc --ORDER BY CASE WHEN [NEW/REVISED] = &#39;REVISED&#39; THEN 0 WHEN [NEW/REVISED] = &#39;NEW&#39; THEN 1 END,[Update Time] DESC<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--DROP INDEX #staticSecurityData.IDX_STATIC_SECURITY_ID<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--DROP INDEX #staticSecurityData.IDX_STATIC_SECURITY_PM_SEC_ID<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DROP INDEX #data_source_price_list_data.IDX_PRICE_LIST_ID<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DROP INDEX #data_source_price_list_data.IDX_PRICE_LIST_PM_SEC_ID<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DROP INDEX #data_source_price_list_final_data.IDX_PRICE_LIST_FINAL_ID<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DROP TABLE #finalData<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DROP TABLE #data_source_price_list_final_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;DROP TABLE #data_source_price_list_data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;--DROP TABLE #staticSecurityData<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;<br />\nEND<br />\n<br />\n<br />\n<br />\nGO