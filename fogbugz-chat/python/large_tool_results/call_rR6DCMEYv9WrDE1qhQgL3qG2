actor_person_id":"2683","assigned_to_person_id":"0","datetime":"2024-08-27T15:23:14Z","text":"select distinct t1.business_day,t1.SecBoxId,t1.description,t1.datasource,t1.Price as current_mark,t1.last_modified_on as updated_time,t2.Price as last_mark,t2.last_modified_on as last_updated_time\nfrom #tempfeed t1 left outer join #tempfeed t2\non t1.id = (t2.id+1) and t1.SecBoxId = t2.SecBoxId\nwhere cast(t1.last_modified_on as date)= @last_modified_on\nand cast(t1.last_modified_on as time)>=@start_time\nand cast(t1.last_modified_on as time)<=@end_time and t1.Price IS NOT NULL","html":"select distinct t1.business_day,t1.SecBoxId,t1.description,t1.datasource,t1.Price as current_mark,t1.last_modified_on as updated_time,t2.Price as last_mark,t2.last_modified_on as last_updated_time<br />\nfrom #tempfeed t1 left outer join #tempfeed t2<br />\non t1.id = (t2.id+1) and t1.SecBoxId = t2.SecBoxId<br />\nwhere cast(t1.last_modified_on as date)= @last_modified_on<br />\nand cast(t1.last_modified_on as time)&gt;=@start_time<br />\nand cast(t1.last_modified_on as time)&lt;=@end_time and t1.Price IS NOT NULL","description":"Edited by Vipin","actor_name":"Vipin","changes":null},{"ixBugEvent":"11935457","event_type":2,"verb":"Edited","actor_person_id":"2683","assigned_to_person_id":"0","datetime":"2024-08-28T07:37:47Z","text":"-- temp datasource list\nCREATE TABLE #data_sources_list(\nid int identity(1,1),data_source_name varchar(200),data_source_table_name varchar(200),security_mapping_table_name varchar(200),field_mapped_to_current_mark varchar(200),primary_identifier varchar(200))\n-- inserting data source list into #data_sources_list \ninsert into #data_sources_list (data_source_name,data_source_table_name,security_mapping_table_name,field_mapped_to_current_mark, primary_identifier)\nselect distinct data_source_name,data_source_table_name,security_mapping_table, femd.feed_field_id, fs.primary_fields\nfrom IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm\njoin IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd\non femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id\njoin IVPPriceMaster.dbo.ivp_pm_attribute attr\non attr.attribute_id=femd.entity_attribute_id\njoin IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs\non fs.feed_summary_id = femm.feed_summary_id\njoin IVPPriceMasterVendor.dbo.ivp_pm_data_source ds\non ds.data_source_id = fs.data_source_id inner join IVPPriceMaster.dbo.ivp_pm_pricing_list_datasource plds \non plds.datasource_id=ds.data_source_id\nwhere plds.is_active=1 and ds.is_active = 1 and fs.is_active = 1\nAND femd.is_active = 1  \nand attr.attribute_real_name = 'Current_Mark' and ltrim(rtrim(femd.feed_field_id)) <> '' AND ds.data_source_id not in (31,33,36,37)\n\nDECLARE @max_data_source_count int = 0;\nDECLARE @data_source_count int = 1;\nDECLARE @data_source_feed_table_name VARCHAR(2000)\nDECLARE @price_column varchar(200)\nDECLARE @primary_identifier varchar(200)\nDECLARE @data_source_name varchar(200)\nDECLARE @query varchar(max)\nDECLARE @last_modified_on date = '20240801'\nDECLARE @start_time time = '00:00:00'\nDECLARE @end_time time = '23:00:00'\nDECLARE @business_day datetime = '20240731'\n\ncreate table #tempfeed\n(\nid int identity(1,1),\nSecBoxId varchar(200),\ndescription varchar(300),\ndatasource varchar(200),\nPrice decimal(18,9),\nlast_modified_on datetime,\nbusiness_day datetime,\n[New/Revised] varchar(100)\n)\n\n\nSELECT @max_data_source_count = COUNT(*) FROM #data_sources_list\n\t\t\t  --loop on datasources\nWHILE(@data_source_count <= @max_data_source_count)\nBEGIN\nselect @data_source_feed_table_name=data_source_table_name,@price_column=field_mapped_to_current_mark,@data_source_name=data_source_name,@primary_identifier=primary_identifier\nfrom #data_sources_list\nwhere id = @data_source_count\n\nSET @query = 'SELECT feed.'+@primary_identifier+',sd.description,feed.DataSource,feed.'+@price_column+',feed.last_modified_on,feed.business_day,null\n                        FROM IVPPriceMasterVendor.dbo.'+@data_source_feed_table_name+'_Log feed inner join IVPPriceMaster.dbo.ivp_pm_static_security_data sd\n\t\t\t\t\t\ton feed.'+@primary_identifier+' = sd.'+@primary_identifier+'\n                        WHERE feed.DataSource='''+@data_source_name+''' AND feed.business_day='''+cast(@business_day as varchar)+'''\n\t\t                ORDER BY feed.'+@primary_identifier+',feed.last_modified_on';\n\n\t\t\t\t\t\tPRINT(@query)\n\t\t\t\t\t\t--inserting feed log table join with security data\n\t\t\t\t\t\tinsert into #tempfeed(SecBoxId,description,datasource,Price,last_modified_on,business_day,[New/Revised])\n\t\t\t\t\t\tEXEC(@query)\n\n\t\t\t\t\t\t SET @query=''\n\t\t\t\t\t\tSET @data_source_feed_table_name=''\n\t\t\t\t\t\tSET @price_column=''\n\t\t\t\t\t\tSET @primary_identifier=''\n\t\t\t\t\t\tSET @data_source_name=''\n\t\t\t\t\t\tSET @data_source_count = @data_source_count+1\nEND\n\ncreate table #finaltable(\npm_pricing_id int identity(1,1),\nAs_of_date date,\nPrimary_Identifier varchar(200),\nBond_Name varchar(400),\nDatasource varchar(200),\nCurrent_mark decimal(18,9),\nupdated_time datetime,\nlast_mark decimal(18,9),\nlast_updated_time datetime,\n[New/Revised] varchar(100))\n\ninsert into #finaltable(As_of_date,Primary_Identifier,Bond_Name,Datasource,Current_mark,updated_time,last_mark,last_updated_time,[New/Revised])\nselect distinct t1.business_day,t1.SecBoxId,t1.description,t1.datasource,t1.Price as current_mark,t1.last_modified_on as updated_time,t2.Price as last_mark,t2.last_modified_on as last_updated_time,\n[[New/Revised]=(CASE WHEN t2.price is not null then 'Revised' else 'New' end)\nfrom #tempfeed t1 left outer join #tempfeed t2\non t1.id = (t2.id+1) and t1.SecBoxId = t2.SecBoxId\nwhere cast(t1.last_modified_on as date)= @last_modified_on\nand cast(t1.last_modified_on as time)>=@start_time\nand cast(t1.last_modified_on as time)<=@end_time and t1.Price IS NOT NULL AND \n(t2.Price is null or t1.price<>t2.price)\norder by t1.last_modified_on\n\nselect * from #finaltable\n\ndrop table #finaltable\ndrop table #tempfeed\ndrop table #data_sources_list","html":"-- temp datasource list<br />\nCREATE TABLE #data_sources_list(<br />\nid int identity(1,1),data_source_name varchar(200),data_source_table_name varchar(200),security_mapping_table_name varchar(200),field_mapped_to_current_mark varchar(200),primary_identifier varchar(200))<br />\n-- inserting data source list into #data_sources_list <br />\ninsert into #data_sources_list (data_source_name,data_source_table_name,security_mapping_table_name,field_mapped_to_current_mark, primary_identifier)<br />\nselect distinct data_source_name,data_source_table_name,security_mapping_table, femd.feed_field_id, fs.primary_fields<br />\nfrom IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm<br />\njoin IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd<br />\non femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id<br />\njoin IVPPriceMaster.dbo.ivp_pm_attribute attr<br />\non attr.attribute_id=femd.entity_attribute_id<br />\njoin IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs<br />\non fs.feed_summary_id = femm.feed_summary_id<br />\njoin IVPPriceMasterVendor.dbo.ivp_pm_data_source ds<br />\non ds.data_source_id = fs.data_source_id inner join IVPPriceMaster.dbo.ivp_pm_pricing_list_datasource plds <br />\non plds.datasource_id=ds.data_source_id<br />\nwhere plds.is_active=1 and ds.is_active = 1 and fs.is_active = 1<br />\nAND femd.is_active = 1&nbsp; <br />\nand attr.attribute_real_name = &#39;Current_Mark&#39; and ltrim(rtrim(femd.feed_field_id)) &lt;&gt; &#39;&#39; AND ds.data_source_id not in (31,33,36,37)<br />\n<br />\nDECLARE @max_data_source_count int = 0;<br />\nDECLARE @data_source_count int = 1;<br />\nDECLARE @data_source_feed_table_name VARCHAR(2000)<br />\nDECLARE @price_column varchar(200)<br />\nDECLARE @primary_identifier varchar(200)<br />\nDECLARE @data_source_name varchar(200)<br />\nDECLARE @query varchar(max)<br />\nDECLARE @last_modified_on date = &#39;20240801&#39;<br />\nDECLARE @start_time time = &#39;00:00:00&#39;<br />\nDECLARE @end_time time = &#39;23:00:00&#39;<br />\nDECLARE @business_day datetime = &#39;20240731&#39;<br />\n<br />\ncreate table #tempfeed<br />\n(<br />\nid int identity(1,1),<br />\nSecBoxId varchar(200),<br />\ndescription varchar(300),<br />\ndatasource varchar(200),<br />\nPrice decimal(18,9),<br />\nlast_modified_on datetime,<br />\nbusiness_day datetime,<br />\n[New/Revised] varchar(100)<br />\n)<br />\n<br />\n<br />\nSELECT @max_data_source_count = COUNT(*) FROM #data_sources_list<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; --loop on datasources<br />\nWHILE(@data_source_count &lt;= @max_data_source_count)<br />\nBEGIN<br />\nselect @data_source_feed_table_name=data_source_table_name,@price_column=field_mapped_to_current_mark,@data_source_name=data_source_name,@primary_identifier=primary_identifier<br />\nfrom #data_sources_list<br />\nwhere id = @data_source_count<br />\n<br />\nSET @query = &#39;SELECT feed.&#39;+@primary_identifier+&#39;,sd.description,feed.DataSource,feed.&#39;+@price_column+&#39;,feed.last_modified_on,feed.business_day,null<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; FROM IVPPriceMasterVendor.dbo.&#39;+@data_source_feed_table_name+&#39;_Log feed inner join IVPPriceMaster.dbo.ivp_pm_static_security_data sd<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;on feed.&#39;+@primary_identifier+&#39; = sd.&#39;+@primary_identifier+&#39;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; WHERE feed.DataSource=&#39;&#39;&#39;+@data_source_name+&#39;&#39;&#39; AND feed.business_day=&#39;&#39;&#39;+cast(@business_day as varchar)+&#39;&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ORDER BY feed.&#39;+@primary_identifier+&#39;,feed.last_modified_on&#39;;<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;PRINT(@query)<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;--inserting feed log table join with security data<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;insert into #tempfeed(SecBoxId,description,datasource,Price,last_modified_on,business_day,[New/Revised])<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;EXEC(@query)<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; SET @query=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SET @data_source_feed_table_name=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SET @price_column=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SET @primary_identifier=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SET @data_source_name=&#39;&#39;<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SET @data_source_count = @data_source_count+1<br />\nEND<br />\n<br />\ncreate table #finaltable(<br />\npm_pricing_id int identity(1,1),<br />\nAs_of_date date,<br />\nPrimary_Identifier varchar(200),<br />\nBond_Name varchar(400),<br />\nDatasource varchar(200),<br />\nCurrent_mark decimal(18,9),<br />\nupdated_time datetime,<br />\nlast_mark decimal(18,9),<br />\nlast_updated_time datetime,<br />\n[New/Revised] varchar(100))<br />\n<br />\ninsert into #finaltable(As_of_date,Primary_Identifier,Bond_Name,Datasource,Current_mark,updated_time,last_mark,last_updated_time,[New/Revised])<br />\nselect distinct t1.business_day,t1.SecBoxId,t1.description,t1.datasource,t1.Price as current_mark,t1.last_modified_on as updated_time,t2.Price as last_mark,t2.last_modified_on as last_updated_time,<br />\n[[New/Revised]=(CASE WHEN t2.price is not null then &#39;Revised&#39; else &#39;New&#39; end)<br />\nfrom #tempfeed t1 left outer join #tempfeed t2<br />\non t1.id = (t2.id+1) and t1.SecBoxId = t2.SecBoxId<br />\nwhere cast(t1.last_modified_on as date)= @last_modified_on<br />\nand cast(t1.last_modified_on as time)&gt;=@start_time<br />\nand cast(t1.last_modified_on as time)&lt;=@end_time and t1.Price IS NOT NULL AND <br />\n(t2.Price is null or t1.price&lt;&gt;t2.price)<br />\norder by t1.last_modified_on<br />\n<br />\nselect * from #finaltable<br />\n<br />\ndrop table #finaltable<br />\ndrop table #tempfeed<br />\ndrop table #data_sources_list<br />\n<br />\n<br />\n<br />\n<br />\n<br />\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;","description":"Edited by Vipin","actor_name":"Vipin","changes":null},{"ixBugEvent":"11935470","event_type":2,"verb":"Edited","actor_person_id":"3923","assigned_to_person_id":"0","datetime":"2024-08-28T07:41:05Z","text":"DECLARE @data_sources_list TABLE (\n    id INT IDENTITY(1,1),\n    data_source_name VARCHAR(200),\n    data_source_table_name VARCHAR(200),\n    security_mapping_table_name VARCHAR(200),\n    field_mapped_to_current_mark VARCHAR(200),\n    primary_identifier VARCHAR(200)\n);\n\n-- Step 2: Insert data into @data_sources_list\nINSERT INTO @data_sources_list (data_source_name, data_source_table_name, security_mapping_table_name, field_mapped_to_current_mark, primary_identifier)\nSELECT DISTINCT \n    data_source_name,\n    data_source_table_name,\n    security_mapping_table,\n    femd.feed_field_id,\n    fs.primary_fields\nFROM \n    IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_master femm\nJOIN \n    IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapping_detail femd ON femd.feed_entity_mapping_master_id = femm.feed_entity_mapping_master_id\nJOIN \n    IVPPriceMaster.dbo.ivp_pm_attribute attr ON attr.attribute_id = femd.entity_attribute_id\nJOIN \n    IVPPriceMasterVendor.dbo.ivp_pm_feed_summary fs ON fs.feed_summary_id = femm.feed_summary_id\nJOIN \n    IVPPriceMasterVendor.dbo.ivp_pm_data_source ds ON ds.data_source_id = fs.data_source_id\nJOIN \n    IVPPriceMaster.dbo.ivp_pm_pricing_list_datasource plds ON plds.datasource_id = ds.data_source_id\nWHERE \n    plds.is_active = 1 \n    AND ds.is_active = 1 \n    AND fs.is_active = 1\n    AND femd.is_active = 1 \n    AND attr.attribute_real_name = 'Current_Mark' \n    AND LTRIM(RTRIM(femd.feed_field_id)) <> '' \n    AND ds.data_source_id NOT IN (31, 33, 36, 37);\n\n-- Step 3: Create a temporary table to hold the combined feed data\nCREATE TABLE #tempfeed (\n    id INT IDENTITY(1,1),\n    SecBoxId VARCHAR(200),\n    description VARCHAR(300),\n    datasource VARCHAR(200),\n    Price DECIMAL(18,9),\n    last_modified_on DATETIME,\n    business_day DATETIME,\n    [New/Revised] VARCHAR(100)\n);\n\n-- Step 4: Insert all relevant data from all data sources into #tempfeed in one go\nINSERT INTO #tempfeed (SecBoxId, description, datasource, Price, last_modified_on, business_day, [New/Revised])\nSELECT \n    feed.@primary_identifier,\n    sd.description,\n    feed.DataSource,\n    feed.@price_column,\n    feed.last_modified_on,\n    feed.business_day,\n    NULL\nFROM \n    @data_sources_list ds\nCROSS APPLY (\n    SELECT \n        feed.@primary_identifier,\n        sd.description,\n        feed.DataSource,\n        feed.@price_column,\n        feed.last_modified_on,\n        feed.business_day,\n        NULL\n    FROM \n        IVPPriceMasterVendor.dbo.[ds.data_source_table_name + '_Log'] feed\n    INNER JOIN \n        IVPPriceMaster.dbo.ivp_pm_static_security_data sd ON feed.@primary_identifier = sd.@primary_identifier\n    WHERE \n        feed.DataSource = ds.data_source_name \n        AND feed.business_day = @business_day\n) AS feed_data;\n\n-- Step 5: Create the final table\nCREATE TABLE #finaltable (\n    pm_pricing_id INT IDENTITY(1,1),\n    As_of_date DATE,\n    Primary_Identifier VARCHAR(200),\n    Bond_Name VARCHAR(400),\n    Datasource VARCHAR(200),\n    Current_mark DECIMAL(18,9),\n    updated_time DATETIME,\n    last_mark DECIMAL(18,9),\n    last_updated_time DATETIME,\n    [New/Revised] VARCHAR(100)\n);\n\n-- Step 6: Populate the final table with the desired data\nINSERT INTO #finaltable (As_of_date, Primary_Identifier, Bond_Name, Datasource, Current_mark, updated_time, last_mark, last_updated_time, [New/Revised])\nSELECT DISTINCT \n    t1.business_day,\n    t1.SecBoxId,\n    t1.description,\n    t1.datasource,\n    t1.Price AS current_mark,\n    t1.last_modified_on AS updated_time,\n    t2.Price AS last_mark,\n    t2.last_modified_on AS last_updated_time,\n    CASE WHEN t2.price IS NOT NULL THEN 'Revised' ELSE 'New' END AS [New/Revised]\nFROM \n    #tempfeed t1 \nLEFT OUTER JOIN \n    #tempfeed t2 ON t1.id = (t2.id + 1) AND t1.SecBoxId = t2.SecBoxId\nWHERE \n    CAST(t1.last_modified_on AS DATE) = @last_modified_on\n    AND CAST(t1.last_modified_on AS TIME) BETWEEN @start_time AND @end_time \n    AND t1.Price IS NOT NULL \n    AND (t2.Price IS NULL OR t1.Price <> t2.Price)\nORDER BY \n    t1.last_modified_on;\n\n-- Step 7: Retrieve the final data\n