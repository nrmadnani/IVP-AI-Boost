mn=[Issue Column] from #tempfeedpos where id=@Count  \n  \n       select @valuefieldid=field_id from IVPRAD..ivp_rad_file_field_details where file_id=@file_id and field_name=@issueColumn  \n       set @valueField='Field_'+CONVERT(varchar(max),@valuefieldid)  \n       print(@valueField)  \n         \n       set @valuequery='  \n       Update #tempfeedpos  \n       set [Issue Column Value]=  \n       (select '+CONVERT(varchar(max),@valueField)+' from IVPPriceMasterVendor_Archive.dbo.ivp_pmd_feed_4   \n       where archive_id= '+CONVERT(varchar(max),@archiveID)+')  \n       where archiveId='+CONVERT(varchar(max),@archiveID)+''  \n  \n       print(@valuequery)  \n       if(@valueFieldid !=0 and @valueField is not null)  \n       exec (@valuequery)  \n         \n      end  \n  \n                 \n     set @Query = 'Insert into #finaltable(  \n         Secsymb ,  \n         ESecType ,  \n         System_Exception ,  \n         [Issue Column],  \n         [Issue Column Value],  \n         Date_Of_Loading ,  \n         Business_Day       \n        )  \n        Select   \n         sd.Secsymb,  \n         sd.ESecType,  \n         asp.failure_reason,  \n         asp.[Issue Column],  \n         asp.[Issue Column Value],  \n         asp.loading_time,  \n         asp.business_day  \n    \n     from #tempfeedpos asp join IVPPriceMaster.dbo.ivp_pm_static_security_data sd  \n     on sd.Secsymb=asp.joinfield  \n     where asp.business_day =''' + CONVERT(varchar(max),@Business_Day) + '''' +'    \n     and asp.failure_reason like '+'''%Failed due to System Validation rules%''' ;  \n    \n     print(@query)  \n    \n     exec(@query)  \n    \n     Update #finaltable  \n     set [Data Source]='Position DataSource'  \n     where [Data Source]=''  \n  \n     drop table #tempfeedpos  \n  \n     Print('Position Data Done')  \n  \n    END  \n  \n    IF(@feedId!=3 and @feedId!=4)  \n    BEGIN  \n     select @attributeId=entity_attribute_id from IVPPriceMasterVendor.dbo.ivp_pm_feed_entity_mapp