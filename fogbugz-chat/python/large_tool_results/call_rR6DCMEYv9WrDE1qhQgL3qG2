d_table_name varchar(500)\n\tDECLARE @security_mapping_table_name varchar(500)\n    DECLARE @price_column varchar(200)\n\t--DECLARE @primary_column varchar(200)\n\tDECLARE @data_source_name varchar(200)\n\n\tDECLARE @data_source_count int = 1\n\tDECLARE @max_data_source_count int = 0\n\n    DECLARE @pricinglist_list Table(\n\t\tid INT IDENTITY(1,1), pricing_list_id INT\n\t)\n\n\t--CREATE TABLE #staticSecurityData (\n\t--\tid int identity(1,1),pm_security_id VARCHAR(200), CUSIP VARCHAR(200), Bond_Name VARCHAR(2000)\n\t--)\n\n\tCREATE TABLE #data_source_price_list_data(\n\t\tid int identity(1,1),pm_security_id VARCHAR(200),Primary_key varchar(500),Datasource varchar(200),Datasource_Mark DECIMAL(28,2), Current_Mark DECIMAL(28,2),last_modified_on datetime,business_day datetime,archive_id int\n\t)\n\n\tCREATE TABLE #data_source_price_list_final_data(\n\t\t\tpm_security_id VARCHAR(200),Primary_key varchar(500),Datasource varchar(200),Datasource_Mark DECIMAL(28,2), Current_Mark DECIMAL(28,2),Updated_Time DATETIME,Last_Mark Decimal(28,2),Last_Updated_Time datetime,business_day datetime,archive_id int\n\t)\n\t\n\tCREATE TABLE #finalData (\n\t\tpm_pricing_id int identity(1,1),[As of Date] date, CUSIP VARCHAR(200),pm_security_id varchar(200),Datasource varchar(200),DataSource_Mark DECIMAL(28,2), Mark DECIMAL(28,2),[Update Time] DATETIME,[Last Mark] DECIMAL(28,2),[Last Updated Time] datetime,[NEW/REVISED] varchar(10)\n\t)\n\n\t\n\n\t--indexes creation\n\t--CREATE CLUSTERED INDEX IDX_STATIC_SECURITY_ID ON #staticSecurityData(id)\n\t--CREATE NONCLUSTERED INDEX IDX_STATIC_SECURITY_PM_SEC_ID ON #staticSecurityData(pm_security_id)\n\tCREATE CLUSTERED INDEX IDX_PRICE_LIST_ID ON #data_source_price_list_data(id)\n\tCREATE NONCLUSTERED INDEX IDX_PRICE_LIST_PM_SEC_ID ON #data_source_price_list_data(pm_security_id)\n\tCREATE CLUSTERED INDEX IDX_PRICE_LIST_FINAL_ID ON #data_source_price_list_final_data(pm_security_id)\n\n\n\n\t\n\t--fetch the pricing list\n\tINSERT INTO @pricinglist_list\n